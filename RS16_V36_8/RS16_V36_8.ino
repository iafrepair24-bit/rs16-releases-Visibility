// ringkasan run 1 tanggal (dibaca sekali saat tanggal dibuka): sesi hari itu (1..), run ke-n dari total sesi
#define HIST_CACHE_N_V38 120
struct RunSumV38{uint32_t total;uint8_t mode,hh,mm,completed;uint8_t daySess,sessRun,sessTotal,pad;uint16_t sessNo;float fin;};
static RunSumV38 runSumV38[HIST_CACHE_N_V38];
static void histLoadDayV38(uint32_t ymd){
  uint16_t n=runLogCountV38(ymd);if(n>HIST_CACHE_N_V38)n=HIST_CACHE_N_V38;histRunCountV38=n;
  uint16_t sessId[HIST_CACHE_N_V38];uint16_t lastSess=0xFFFF;uint8_t day=0;
  for(uint16_t i=0;i<n;i++){
    RunSumV38& q=runSumV38[i];memset(&q,0,sizeof(q));sessId[i]=0;
    if(!runLogReadV38(ymd,i))continue;
    const RunLogV38& r=runLogV38;
    q.total=r.total;q.mode=r.mode;q.hh=r.hh;q.mm=r.mm;q.completed=r.completed;q.sessRun=r.sessRun?r.sessRun:1;
    sessId[i]=r.sessNo;q.sessNo=r.sessNo;for(uint8_t k=0;k<DRAG_CP_N;k++)if(r.target[k]>q.fin)q.fin=r.target[k];
    if(i==0||r.sessNo!=lastSess||r.sessNo==0){day++;lastSess=r.sessNo;}
    q.daySess=day;
  }
  for(uint16_t i=0;i<n;i++){uint8_t t=0;for(uint16_t j=0;j<n;j++)if(runSumV38[j].daySess==runSumV38[i].daySess&&runSumV38[j].sessRun>t)t=runSumV38[j].sessRun;runSumV38[i].sessTotal=t;}
}
