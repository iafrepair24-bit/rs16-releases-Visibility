static bool i2cWriteV31(uint8_t a,uint8_t r,uint8_t v){Wire.beginTransmission(a);Wire.write(r);Wire.write(v);return Wire.endTransmission()==0;}
static bool i2cReadV31(uint8_t a,uint8_t r,uint8_t* b,uint8_t n){Wire.beginTransmission(a);Wire.write(r);if(Wire.endTransmission(false)!=0)return false;uint8_t got=Wire.requestFrom((int)a,(int)n,(int)true);if(got!=n)return false;for(uint8_t i=0;i<n;i++)b[i]=Wire.read();return true;}
// ---- akses register ICM-42688-P / LSM6DS3 lewat SPI (bus dipakai bareng TFT, CS sendiri di ICM_CS_PIN) ----
// 12 Nov 2026: SPI mode 3 (CPOL=1, CPHA=1). ICM-42688 mendukung mode 0 & 3, LSM6DS3/LSM6DSx hanya
// dijamin di mode 3 -> mode 3 dipakai supaya U8 bisa diisi salah satu chip tanpa ganti firmware.
// 13 Nov 2026: mode dipilih saat deteksi -- coba mode 3 dulu, lalu mode 0 (beberapa chip/papan hanya
// menjawab di salah satunya). Nilai WHO_AM_I yang terbaca dicatat untuk log boot & perintah "imu".
static uint8_t imuSpiModeV37 = SPI_MODE3;
#define IMU_SPI_MODE_V36 imuSpiModeV37
static uint8_t imuDiagIcmV37[2]={0,0}, imuDiagLsmV37[2]={0,0};
static void icmWriteRegV36(uint8_t reg,uint8_t val){
  lcdSPI.beginTransaction(SPISettings(1000000,MSBFIRST,IMU_SPI_MODE_V36));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg&0x7F);lcdSPI.transfer(val);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
}
static uint8_t icmReadRegV36(uint8_t reg){
  lcdSPI.beginTransaction(SPISettings(500000,MSBFIRST,IMU_SPI_MODE_V36));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg|0x80);uint8_t v=lcdSPI.transfer(0x00);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
  return v;
}
static bool icmReadBurstV36(uint8_t reg,uint8_t* buf,uint8_t n){
  lcdSPI.beginTransaction(SPISettings(4000000,MSBFIRST,IMU_SPI_MODE_V36));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg|0x80);for(uint8_t i=0;i<n;i++)buf[i]=lcdSPI.transfer(0x00);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
  return true;
}
// ---- V36.2 akses register LSM6DS3: SPI (protokol sama dengan ICM: bit7=read) atau I2C ----
static bool imuLsmSpiV36=false;
static void lsmWriteRegV36(uint8_t reg,uint8_t val){if(imuLsmSpiV36)icmWriteRegV36(reg,val);else i2cWriteV31(imuAddressV31,reg,val);}
static uint8_t lsmReadRegV36(uint8_t reg){if(imuLsmSpiV36)return icmReadRegV36(reg);uint8_t v=0;i2cReadV31(imuAddressV31,reg,&v,1);return v;}
static bool lsmReadBurstV36(uint8_t reg,uint8_t* b,uint8_t n){if(imuLsmSpiV36)return icmReadBurstV36(reg,b,n);return i2cReadV31(imuAddressV31,reg,b,n);}

static bool initImuV31(){
  // Chip aktual di PCB produksi = ICM-42688-P (InvenSense/TDK) lewat SPI. Dicek duluan.
  // WHO_AM_I: 0x47 = ICM-42688-P, 0xDB = ICM-42688-V, 0x42 = ICM-42605 (peta register sama).
  auto icmWhoOk=[](uint8_t w){return w==0x47||w==0xDB||w==0x42;};
  auto lsmWhoOk=[](uint8_t w){return w==0x69||w==0x6A||w==0x6B||w==0x6C||w==0x70||w==0x71;};
  uint8_t who=0;
  digitalWrite(ICM_CS_PIN,HIGH);digitalWrite(TFT_CS,HIGH);digitalWrite(FLASH_CS_PIN,HIGH);digitalWrite(RS16_SD_CS_PIN,HIGH);
  delay(20);   // waktu boot LSM6 (maks ~10-35 ms setelah daya)
  {
    static const uint8_t modes[2]={SPI_MODE3,SPI_MODE0};
    bool hit=false;
    for(uint8_t m=0;m<2&&!hit;m++){
      imuSpiModeV37=modes[m];
      // 13 Nov 2026: baca 3x -- byte pertama setelah ganti mode SPI kadang salah (bus dipakai LCD)
      uint8_t wl=0;
      for(uint8_t r=0;r<3&&!hit;r++){
        who=icmReadRegV36(0x75);wl=icmReadRegV36(0x0F);
        hit=icmWhoOk(who)||lsmWhoOk(wl);delayMicroseconds(200);
      }
      imuDiagIcmV37[m]=who;imuDiagLsmV37[m]=wl;
    }
    if(!hit)imuSpiModeV37=SPI_MODE3;
  }
  if(icmWhoOk(who)){
    imuWhoV31=who;imuTypeV36=IMU_TYPE_ICM42688_V36;
    // FIX V36.2: dulu ditulis 0x10 = bit4 SPI_MODE (pindah ke SPI mode 1/2!), BUKAN reset.
    // Soft reset ICM-42688-P = bit0 (SOFT_RESET_CONFIG) -> 0x01. SPI tetap mode 0/3.
    icmWriteRegV36(0x11,0x01);delay(2);                 // DEVICE_CONFIG: soft reset
    delay(50);                                          // tunggu reset selesai
    // INTF_CONFIG0: matikan antarmuka I2C (UI_SIFS_CFG=11) supaya trafik SPI LCD di SCK/MOSI yang sama
    // tidak pernah dibaca chip sebagai I2C. Bit endian (0x30) tetap big-endian sesuai pembacaan di bawah.
    icmWriteRegV36(0x4C,0x33);
    icmWriteRegV36(0x4E,0x0F);                          // PWR_MGMT0: accel+gyro Low Noise mode
    delay(50);                                          // startup time accel/gyro LN mode (datasheet)
    icmWriteRegV36(0x4F,0x46);                          // GYRO_CONFIG0 : +-500 dps, ODR 1kHz
    icmWriteRegV36(0x50,0x46);                          // ACCEL_CONFIG0: +-4 g,   ODR 1kHz (headroom hentakan/polisi tidur)
    imuConnectedV31=true;return true;
  }
  // V36.2: alternatif LSM6DS3 / LSM6DS3TR-C / LSM6DSO. Dulu tipe ini tidak pernah terdeteksi
  // (kode bacanya ada tapi mati). Dicek lewat SPI (CS GPIO5 yang sama) dulu, lalu I2C 0x6A/0x6B.
  // WHO_AM_I reg 0x0F: 0x69 = LSM6DS3, 0x6A = LSM6DS3TR-C/LSM6DSL, 0x6B = LSM6DSR/ISM330, 0x6C = LSM6DSO.
  {
    uint8_t w=icmReadRegV36(0x0F);
    bool found=false;
    if(lsmWhoOk(w)){imuLsmSpiV36=true;found=true;}
    else{
      const uint8_t la[2]={0x6A,0x6B};
      for(uint8_t i=0;i<2&&!found;i++){if(i2cReadV31(la[i],0x0F,&w,1)&&lsmWhoOk(w)){imuAddressV31=la[i];imuLsmSpiV36=false;found=true;}}
    }
    if(found){
      imuWhoV31=w;imuTypeV36=IMU_TYPE_LSM6DS3_V36;imuLsmDsvV37=(w==0x70||w==0x71);
      lsmWriteRegV36(0x12,0x01);delay(30);   // CTRL3_C: SW_RESET (bit0, sama di semua LSM6)
      lsmWriteRegV36(0x12,0x44);             // CTRL3_C: BDU=1, IF_INC=1 (auto-increment burst)
      if(imuLsmDsvV37){
        // LSM6DSV/LSM6DSV16X: ODR & full-scale ada di register lain (CTRL1/2 = ODR, CTRL6 = FS gyro, CTRL8 = FS accel)
        if(imuLsmSpiV36)lsmWriteRegV36(0x03,0x01);   // IF_CFG: I2C/I3C_disable
        lsmWriteRegV36(0x17,0x01);           // CTRL8 : FS_XL +-4 g
        lsmWriteRegV36(0x15,0x02);           // CTRL6 : FS_G +-500 dps
        lsmWriteRegV36(0x10,0x08);           // CTRL1 : accel high-performance, ODR 480 Hz
        lsmWriteRegV36(0x11,0x08);           // CTRL2 : gyro  high-performance, ODR 480 Hz
      }else{
        // CTRL4_C bit2 I2C_disable: di SPI bus bersama LCD, I2C chip dimatikan (rekomendasi ST).
        if(imuLsmSpiV36)lsmWriteRegV36(0x13,0x04);
        lsmWriteRegV36(0x10,0x68);           // CTRL1_XL: ODR 416 Hz, +-4 g
        lsmWriteRegV36(0x11,0x64);           // CTRL2_G : ODR 416 Hz, +-500 dps (sama dengan ICM)
      }
      delay(30);
      // verifikasi: setelah reset WHO_AM_I harus tetap sama (kalau tidak = solder/jalur MISO bermasalah)
      if(lsmReadRegV36(0x0F)!=w){imuTypeV36=IMU_TYPE_NONE_V36;imuConnectedV31=false;Serial.printf("IMU %s gagal verifikasi setelah reset\n",lsmNameV37(w));return false;}
      imuConnectedV31=true;return true;
    }
  }
  // fallback: board breadboard lama dengan MPU6050 (I2C, tetap didukung untuk kompatibilitas)
  const uint8_t addrsV31[2] = {0x68, 0x69};
  for(uint8_t ai=0; ai<2; ++ai){
    const uint8_t a=addrsV31[ai]; uint8_t whoM=0;
    if(i2cReadV31(a,0x75,&whoM,1)&&(whoM==0x68||whoM==0x69||whoM==0x70||whoM==0x71||whoM==0x72||whoM==0x73)){
      imuAddressV31=a;imuWhoV31=whoM;imuTypeV36=IMU_TYPE_MPU6050_V36;i2cWriteV31(a,0x6B,0x00);delay(20);
      i2cWriteV31(a,0x1A,0x03);   // CONFIG: DLPF ~44 Hz
      i2cWriteV31(a,0x1B,0x08);   // GYRO_CONFIG : +-500 dps (sama dengan ICM produksi)
      i2cWriteV31(a,0x1C,0x08);   // ACCEL_CONFIG: +-4 g (headroom hentakan/polisi tidur)
      i2cWriteV31(a,0x19,0x04);   // SMPLRT_DIV: 1 kHz/(1+4) = 200 Hz
      imuConnectedV31=true;return true;
    }
  }
  imuTypeV36=IMU_TYPE_NONE_V36;imuConnectedV31=false;return false;
}
static void saveImuOffsetsV31(){prefsV31.putFloat("oax",imuOffAxV31);prefsV31.putFloat("oay",imuOffAyV31);prefsV31.putFloat("oaz",imuOffAzV31);prefsV31.putFloat("ogx",imuOffGxV31);prefsV31.putFloat("ogy",imuOffGyV31);prefsV31.putFloat("ogz",imuOffGzV31);}
static void startImuCalV31(uint8_t mode){imuCalModeV31=mode;imuCalActiveV31=true;imuCalCountV31=0;calAxV31=calAyV31=calAzV31=calGxV31=calGyV31=calGzV31=0;screenDirtyV31=true;}
static void serviceImuV31(){
  uint32_t nowUs=micros(); if(!imuConnectedV31){if(millis()-imuLastRetryV31>2000){imuLastRetryV31=millis();initImuV31();}return;} if((uint32_t)(nowUs-imuLastUsV31)<5000UL)return;imuLastUsV31=nowUs;
  float ax,ay,az,gx,gy,gz;
  if(imuTypeV36==IMU_TYPE_ICM42688_V36){
    // V36.2: burst read SPI tidak pernah "gagal" (jalur kosong terbaca 0x00/0xFF), jadi dulu IMU
    // yang lepas tetap dianggap tersambung dengan data ngawur. Cek WHO_AM_I tiap 1 detik.
    if(millis()-imuWhoCheckMsV36>1000UL){imuWhoCheckMsV36=millis();if(icmReadRegV36(0x75)!=imuWhoV31){imuConnectedV31=false;imuTypeV36=IMU_TYPE_NONE_V36;Serial.println("IMU LOST (WHO_AM_I)");return;}}
    // ICM-42688-P: 0x1F = ACCEL_DATA_X1, lalu Y,Z, lalu GYRO X,Y,Z -- big-endian (MSB dulu), sama seperti MPU6050
    uint8_t b[12];if(!icmReadBurstV36(0x1F,b,12)){if(++imuErrorsV31>20){imuConnectedV31=false;imuErrorsV31=0;}return;}imuErrorsV31=0;
    auto s16=[&](uint8_t o)->int16_t{return (int16_t)(((uint16_t)b[o]<<8)|b[o+1]);};
    ax=s16(0)*0.000122f;ay=s16(2)*0.000122f;az=s16(4)*0.000122f;      // +-4g   -> 0.122 mg/LSB
    gx=s16(6)*0.0152588f;gy=s16(8)*0.0152588f;gz=s16(10)*0.0152588f;  // +-500dps -> 0.01526 dps/LSB
  }else if(imuTypeV36==IMU_TYPE_LSM6DS3_V36){
    // LSM6DS3: 0x22 = OUTX_L_G .. gyro XYZ lalu accel XYZ, little endian. V36.2: lewat SPI atau I2C.
    if(millis()-imuWhoCheckMsV36>1000UL){imuWhoCheckMsV36=millis();const uint8_t w=lsmReadRegV36(0x0F);if(w!=imuWhoV31){imuConnectedV31=false;imuTypeV36=IMU_TYPE_NONE_V36;Serial.println("IMU LOST (WHO_AM_I)");return;}}
    uint8_t b[12];if(!lsmReadBurstV36(0x22,b,12)){if(++imuErrorsV31>20){imuConnectedV31=false;imuErrorsV31=0;}return;}imuErrorsV31=0;
    auto s16le=[&](uint8_t o)->int16_t{return (int16_t)(((uint16_t)b[o+1]<<8)|b[o]);};
    gx=s16le(0)*0.0175f;gy=s16le(2)*0.0175f;gz=s16le(4)*0.0175f;          // +-500 dps -> 17.5 mdps/LSB
    ax=s16le(6)*0.000122f;ay=s16le(8)*0.000122f;az=s16le(10)*0.000122f;   // +-4 g -> 0.122 mg/LSB
  }else{
    uint8_t b[14];if(!i2cReadV31(imuAddressV31,0x3B,b,14)){if(++imuErrorsV31>20){imuConnectedV31=false;imuErrorsV31=0;}return;}imuErrorsV31=0;
    auto s16=[&](uint8_t o)->int16_t{return (int16_t)(((uint16_t)b[o]<<8)|b[o+1]);};
    // MPU6050: +-4 g -> 8192 LSB/g, +-500 dps -> 65.5 LSB/dps (byte 6-7 = suhu, dilewati)
    ax=s16(0)/8192.0f;ay=s16(2)/8192.0f;az=s16(4)/8192.0f;gx=s16(8)/65.5f;gy=s16(10)/65.5f;gz=s16(12)/65.5f;
  }
  if(imuCalActiveV31){calAxV31+=ax;calAyV31+=ay;calAzV31+=az;calGxV31+=gx;calGyV31+=gy;calGzV31+=gz;imuCalCountV31++;
    if(imuCalCountV31>=400){float n=(float)imuCalCountV31;if(imuCalModeV31==0||imuCalModeV31==2){imuOffAxV31=calAxV31/n;imuOffAyV31=calAyV31/n;imuOffAzV31=calAzV31/n-1.0f;}if(imuCalModeV31==1||imuCalModeV31==2){imuOffGxV31=calGxV31/n;imuOffGyV31=calGyV31/n;imuOffGzV31=calGzV31/n;}saveImuOffsetsV31();imuCalActiveV31=false;screenDirtyV31=true;}}
  imuAxV31=ax-imuOffAxV31;imuAyV31=ay-imuOffAyV31;imuAzV31=az-imuOffAzV31;imuGxV31=gx-imuOffGxV31;imuGyV31=gy-imuOffGyV31;imuGzV31=gz-imuOffGzV31;
  gLongV31=imuAxV31;gLatV31=imuAyV31;if(gLongV31>peakAccelGV31)peakAccelGV31=gLongV31;if(-gLongV31>peakBrakeGV31)peakBrakeGV31=-gLongV31;if(fabsf(gLatV31)>peakLatGV31)peakLatGV31=fabsf(gLatV31);
  if(-gLatV31>peakLatLeftV36)peakLatLeftV36=-gLatV31;if(gLatV31>peakLatRightV36)peakLatRightV36=gLatV31;
  {const uint32_t nowUs=micros();const float accLean=atan2f(imuAyV31,imuAzV31)*57.2958f,accPitch=atan2f(-imuAxV31,imuAzV31)*57.2958f;
   if(!attInitV38||(uint32_t)(nowUs-attLastUsV38)>500000UL){attLeanV38=accLean;attPitchV38=accPitch;attInitV38=true;}
   else{const float dt=(nowUs-attLastUsV38)*1e-6f;const float k=dt/(2.0f+dt);
     attLeanV38=(attLeanV38+imuGxV31*dt)*(1.0f-k)+accLean*k;attPitchV38=(attPitchV38+imuGyV31*dt)*(1.0f-k)+accPitch*k;}
   attLastUsV38=nowUs;}
}

// ---------- one shared real telemetry buffer ----------
// V36.2: array telemetryV31[600] (~28,8 KB RAM) DIHAPUS -- diisi tapi tidak pernah dibaca di mana pun.
// RAM-nya dipakai framebuffer anti-kedip. Yang tetap jalan: cross-check akselerasi GPS vs IMU.
static uint16_t telemetryCountV31=0;
static bool gpsImuMismatchV36=false; static uint8_t gpsImuMismatchCountV36=0;
static uint32_t telemetryLastSeqV31=0;static bool telemetryHavePrevV31=false;static double telemetryPrevLatV31=0,telemetryPrevLonV31=0;static float telemetryPrevSpeedMpsV31=0;static uint32_t telemetryPrevTowV31=0;static float telemetryDistanceV31=0;
static void resetTelemetryV31(){telemetryCountV31=0;telemetryHavePrevV31=false;telemetryDistanceV31=0;telemetryLastSeqV31=gpsPvtSequenceV30;}
static void serviceTelemetryV31(){
  if(telemetryLastSeqV31==gpsPvtSequenceV30||gpsPvtSequenceV30==0)return;telemetryLastSeqV31=gpsPvtSequenceV30;float acc=0;
  if(telemetryHavePrevV31){float step=gpsDistanceMetersV30(telemetryPrevLatV31,telemetryPrevLonV31,gpsLatitudeV30,gpsLongitudeV30);if(step>=0&&step<15)telemetryDistanceV31+=step;uint32_t dt=gpsTowDeltaMsV30(gpsITowMsV30,telemetryPrevTowV31);if(dt>0&&dt<500)acc=((gpsSpeedKmhV30/3.6f)-telemetryPrevSpeedMpsV31)/(dt*0.001f);}
  // V36.1 cross-check GPS vs IMU: deteksi lonjakan data GPS yang tidak didukung akselerasi IMU
  if(imuConnectedV31&&telemetryHavePrevV31){
    const float imuAccel=gLongV31*9.80665f;
    if(fabsf(acc-imuAccel)>6.0f){ if(gpsImuMismatchCountV36<250)gpsImuMismatchCountV36++; }
    else if(gpsImuMismatchCountV36) gpsImuMismatchCountV36--;
    bool bad=(gpsImuMismatchCountV36>=3);
    if(bad!=gpsImuMismatchV36){
      gpsImuMismatchV36=bad;
      Serial.printf("GPS/IMU CROSS-CHECK %s (gps %.2f m/s2, imu %.2f m/s2)\n",bad?"MISMATCH":"OK",acc,imuAccel);
    }
  }
  if(telemetryCountV31<0xFFFF)telemetryCountV31++;
  telemetryPrevLatV31=gpsLatitudeV30;telemetryPrevLonV31=gpsLongitudeV30;telemetryPrevSpeedMpsV31=gpsSpeedKmhV30/3.6f;telemetryPrevTowV31=gpsITowMsV30;telemetryHavePrevV31=true;
}

