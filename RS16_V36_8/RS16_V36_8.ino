// V36.2: layar yang digambar lewat framebuffer = semua layar non-bitmap.
static bool uiFbScreenV36(){
  switch(uiTestScreen){
    case UI_MAIN_MENU: case UI_DRAG_PAGE1: case UI_DRAG_PAGE2: case UI_DRAG_READY:
    case UI_CIRCUIT_MENU: case UI_ACCEL_MENU: case UI_ACCEL_CAL_MENU:
      return false;
    default: return true;
  }
}
static bool periodicUiV31(){
  switch(uiTestScreen){
    case UI_DRAG_RUNNING:
    case UI_DRAG_FINISH:   // 13 Nov 2026: speed & distance LIVE setelah finish
    case UI_CIRCUIT_STANDBY:
    case UI_CIRCUIT_RUNNING:
    case UI_GPS_LOGGER_STANDBY:
    case UI_GPS_LOGGER_RECORDING:
    case UI_GPS_LOGGER_INFO:
    case UI_ACCEL_GMETER:
    case UI_ACCEL_CAL_RUNNING:
    case UI_ACCEL_SENSOR_INFO:
    case UI_APPLICATION_PHONE_LINK:
    case UI_APPLICATION_FW_UPDATE:
    case UI_APPLICATION_CONNECTION_INFO:
    case UI_SETTINGS_SYSTEM_INFO:
    case UI_GNSS_MENU:
    case UI_GNSS_COLDSTART:
    case UI_GPS_SATELLITE:
      return true;
    default:
      return false;
  }
}


static void renderDynamicV31(bool force=false){
  const uint32_t now=millis();
  const bool periodic=periodicUiV31();

  if(!force && !screenDirtyV31){
    if(!periodic) return;
    if(now-lastDynamicUiMsV31<(uiTestScreen==UI_GPS_SATELLITE?250UL:100UL)) return;
  }

  lastDynamicUiMsV31=now;
  screenDirtyV31=false;

  const bool fb=uiFbScreenV36()&&fbFrameBeginV37((uint8_t)uiTestScreen);   // V36.2 anti-kedip (tag = layar)
  switch(uiTestScreen){
    case UI_CUSTOM_INTERVAL:drawCustomIntervalV31();break;
    case UI_SPEED0_SETUP:drawSpeed0SetupV36();break;
    case UI_DRAG_SETUP_V38:drawDragSetupV38();break;
    case UI_HIST_CAL_V38:drawHistCalendarV38();break;
    case UI_HIST_RUNS_V38:drawHistRunsV38();break;
    case UI_HIST_RUN_V38:drawHistRunV38();break;
    case UI_HIST_TYPE_V38:drawHistTypeV38();break;
    case UI_HIST_CLAPS_V38:drawHistCircListV38();break;
    case UI_HIST_CLAP_V38:drawHistCircLapsV38();break;
    case UI_HIST_MONTH_V39:drawHistMonthV39();break;
    case UI_HIST_SESS_V39:drawHistSessV39();break;
    case UI_HIST_LOG_V39:drawHistLogV39();break;
    case UI_DRAG_READY:drawDragStandbyV31();break;
    case UI_DRAG_RUNNING:drawDragRunningV31();break;
    case UI_DRAG_FINISH:if(dragFinishGraphV36)drawDragGraphV36();else drawDragFinishV31();break;
    case UI_GNSS_MENU:drawGnssMenuV36();break;
    case UI_GPS_SATELLITE:drawGpsSatelliteV31();break;
    case UI_GNSS_COLDSTART:drawGnssColdStartV36();break;
    case UI_GNSS_SYSTEM:drawGnssSystemV36();break;
    case UI_GNSS_RATE:drawGnssRateV36();break;
    case UI_HISTORY_EMPTY:drawHistoryEmptyV31();break;
    case UI_HISTORY_DETAIL:drawHistoryDetailV37();break;
    case UI_CIRCUIT_TRACK:drawCircuitTrackMenuV31();break;
    case UI_CIRCUIT_SECTOR:drawCircuitSectorMenuV31();break;
    case UI_CIRCUIT_SETUP:drawCircuitSetupMenuV31();break;
