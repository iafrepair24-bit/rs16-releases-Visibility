static const GlyphV37* const FONT_TABLES_V37[5] = {FONT_G1_V37,FONT_G2_V37,FONT_G3_V37,FONT_G4_V37,FONT_G5_V37};
static const uint8_t FONT_SPACE_V37[5] = {4,7,10,14,18};

static int16_t fontGlyphIndexV37(char ch){
  if(ch>='a'&&ch<='z')ch-=32;
  if(ch<33||ch>126)return -1;
  for(int16_t i=0;;i++){const char c=(char)pgm_read_byte(&FONT_CHARS_V37[i]);if(!c)return -1;if(c==ch)return i;}
}
static inline uint8_t fontTabV37(uint8_t scale){return scale<=1?0:(scale>=5?4:scale-1);}
static inline void fontGlyphV37(uint8_t t,int16_t i,GlyphV37* g){memcpy_P(g,&FONT_TABLES_V37[t][i],sizeof(GlyphV37));}
// V36.6 huruf TEBAL + jarak antar huruf: tiap garis solid ditebalkan 1 px ke kanan, lalu tiap huruf diberi jarak
// (kecil 1 px, besar 2 px) supaya tidak menempel/dempet. Lebar teks ikut dihitung, jadi rata tengah/kanan tetap pas.
static inline uint8_t fontExtraV38(uint8_t t){(void)t;return 1;}   // V36.7: huruf kecil tidak ditebalkan, jarak 1 px
int16_t textWidthV31(const char* s,uint8_t scale=1){
  if(!s||!*s)return 0; const uint8_t t=fontTabV37(scale); int16_t w=0;
  for(;*s;s++){const int16_t i=fontGlyphIndexV37(*s);if(i<0){w+=FONT_SPACE_V37[t];continue;}GlyphV37 g;fontGlyphV37(t,i,&g);w+=g.adv+fontExtraV38(t);}
  return w;
}
// campur warna fg ke bg sebanyak k/3 (anti-alias tepi huruf)
static uint16_t blend565V37(uint16_t fg,uint16_t bg,uint8_t k){
  const uint16_t r=(((fg>>11)&31)*k+((bg>>11)&31)*(3-k))/3, g=(((fg>>5)&63)*k+((bg>>5)&63)*(3-k))/3, b=((fg&31)*k+(bg&31)*(3-k))/3;
  return (uint16_t)((r<<11)|(g<<5)|b);
}
// warna di bawah huruf: dari framebuffer kalau aktif (blend tepat di atas panel/kotak), selain itu warna bg
static inline uint16_t pixelUnderV37(int16_t x,int16_t y,uint16_t bg){
  if(fbActiveV36&&x>=0&&y>=0&&x<LCD_W&&y<LCD_H)return fbPalV36[fbV36[(uint32_t)y*LCD_W+x]];
  return bg;
}
int16_t drawGlyphV31(int16_t x,int16_t y,char ch,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  const uint8_t t=fontTabV37(scale); const int16_t i=fontGlyphIndexV37(ch);
  if(i<0){if(opaque)fillRect(x,y,FONT_SPACE_V37[t],8*scale,bg);return FONT_SPACE_V37[t];}
  GlyphV37 g;fontGlyphV37(t,i,&g);
  const uint8_t ex=fontExtraV38(t);
  if(opaque)fillRect(x,y,g.adv+ex,8*scale+(t?0:1),bg);
  uint32_t bit=(uint32_t)g.off*4;
  const uint8_t* const bits=FONT_BITS_V37;const uint8_t bold=0;   // V36.8: tanpa penebalan
  for(uint8_t r=0;r<g.h;r++){
    const int16_t py=y+g.yo+r; int16_t run=-1;
    for(uint8_t c=0;c<=g.w;c++){
      uint8_t v=0;
      if(c<g.w){v=(pgm_read_byte(&bits[bit>>2])>>(6-2*(bit&3)))&3;bit++;}
      if(v==3){if(run<0)run=c;continue;}
      if(run>=0){fillRect(x+g.xo+run,py,c-run+bold,1,fg);run=-1;if(bold)continue;}   // +1 = tebal (menutup piksel tepi ini)
      if(v){const int16_t px=x+g.xo+c;fillRect(px,py,1,1,blend565V37(fg,opaque?bg:pixelUnderV37(px,py,bg),v));}
    }
  }
  return g.adv+ex;
}
void drawTextV31(int16_t x,int16_t y,const char* s,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  if(!s)return; while(*s){x+=drawGlyphV31(x,y,*s,fg,scale,bg,opaque);s++;}
}
void drawTextCenteredV31(int16_t cx,int16_t y,const char* s,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  drawTextV31(cx-textWidthV31(s,scale)/2,y,s,fg,scale,bg,opaque);
}
void drawTextRightV31(int16_t xr,int16_t y,const char* s,uint16_t fg,uint8_t scale=1){ drawTextV31(xr-textWidthV31(s,scale),y,s,fg,scale); }
void drawPanelV31(int16_t x,int16_t y,int16_t w,int16_t h,bool selected=false){
  fillRect(x,y,w,h,C_V31_PANEL); drawRectV31(x,y,w,h,selected?C_V31_BLUE:C_V31_EDGE);
  if(selected) drawRectV31(x+1,y+1,w-2,h-2,C_V31_BLUE_DIM);
}

// ---------- V36.1 gaya seleksi global: kotak abu-abu, sudut membulat, tepi halus ----------
void drawRoundSelectV36(int16_t x,int16_t y,int16_t w,int16_t h,int16_t r=10,uint16_t col=C_V31_GRAY){
  if(w<6||h<6)return;
  int16_t maxR=(w<h?w:h)/2; if(r>maxR)r=maxR; if(r<2)r=2;
  const float T=2.4f, rc=(float)r-T*0.5f;
  const uint8_t cr=(uint8_t)((col>>11)&0x1F), cg=(uint8_t)((col>>5)&0x3F), cb=(uint8_t)(col&0x1F);
  // sisi lurus
  fillRect(x+r,y,w-2*r,2,col);
  fillRect(x+r,y+h-2,w-2*r,2,col);
  fillRect(x,y+r,2,h-2*r,col);
  fillRect(x+w-2,y+r,2,h-2*r,col);
  // sudut membulat dengan tepi dihaluskan
  for(uint8_t c=0;c<4;c++){
    const int16_t ox=(c&1)?(x+w-r):x;
    const int16_t oy=(c&2)?(y+h-r):y;
    const float cx=(c&1)?(float)(x+w-r):(float)(x+r);
    const float cy=(c&2)?(float)(y+h-r):(float)(y+r);
    for(int16_t py=0;py<r;py++){
      for(int16_t px=0;px<r;px++){
        const float dx=(float)(ox+px)+0.5f-cx;
        const float dy=(float)(oy+py)+0.5f-cy;
        const float d=sqrtf(dx*dx+dy*dy);
        float a=1.0f-(fabsf(d-rc)-(T*0.5f-0.5f));
        if(a<=0.05f)continue; if(a>1.0f)a=1.0f;
        const uint16_t cc=(uint16_t)(((uint16_t)(cr*a+0.5f)<<11)|((uint16_t)(cg*a+0.5f)<<5)|(uint16_t)(cb*a+0.5f));
        if(cc)fillRect(ox+px,oy+py,1,1,cc);
      }
    }
  }
}

// Tabel penghapus panel/kotak bawaan pada bitmap layar menu (bitmap aslinya tidak diubah).
struct ScreenEraseRun { uint8_t y; uint16_t x; uint16_t len; } __attribute__((packed));
static void drawScreenEraseV36(const ScreenEraseRun* runs,uint16_t n){
  for(uint16_t i=0;i<n;i++){
    const uint8_t y=pgm_read_byte(&runs[i].y);
    const uint16_t x=pgm_read_word(&runs[i].x);
    const uint16_t len=pgm_read_word(&runs[i].len);
    fillRect((int16_t)x,(int16_t)y,(int16_t)len,1,C_V31_BG);
  }
}
