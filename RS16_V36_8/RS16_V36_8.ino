// - SUDAH DAPAT SATELIT, BELUM LOCK: silang hilang, batang ABU-ABU sesuai jumlah satelit.
// - SUDAH LOCK (3D fix stabil): batang BIRU.
static bool gpsTimingReadyV31();
static void drawSatIconV36(){
  uint8_t bars=0;
  const uint8_t satDisplay=gpsSatellitesV30?gpsSatellitesV30:gpsSatViewCountV32;
  if(satDisplay>=4)bars=1;if(satDisplay>=7)bars=2;if(satDisplay>=10)bars=3;if(satDisplay>=14)bars=4;
  const bool locked=gpsTimingReadyV31();
  if(locked&&bars==0)bars=1;
  if(bars==0){
    // V36.7: belum dapat sinyal -> HANYA silang merah (tanpa kotak bar kosong)
    for(int8_t k=0;k<3;k++){drawLineV31(284+k,7,296+k,19,C_V31_RED);drawLineV31(296+k,7,284+k,19,C_V31_RED);}
    return;
  }
  // sudah dapat sinyal -> bar (abu-abu = belum lock, biru = lock)
  const int16_t bx=275;
  for(uint8_t i=0;i<4;i++){
    const uint8_t h=(uint8_t)(4+i*3);
    drawRectV31(bx+i*9,19-h,6,h,C_V31_DARK);
    if(i<bars)fillRect(bx+i*9+1,20-h,4,h-2,locked?C_V31_BLUE:C_V31_GRAY);
  }
}

