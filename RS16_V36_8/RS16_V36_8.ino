// Tombol sekarang dibaca dari PCF8574 (I2C expander), bukan GPIO langsung lagi.
// BUTTON_PINS di sini isinya index BIT PCF8574 (0-7), bukan nomor GPIO.
// FIX 6 Sep 2026: tombol RIGHT (bit P4) ikut dibaca sekarang -- index 4. Sebelumnya terbaca
// oleh hardware tapi tidak pernah di-poll sama sekali. Dipakai di layar Circuit Running untuk
// menandai sektor manual, supaya tombol OK bisa dikembalikan fungsinya sebagai "stop sesi"
// sesuai keputusan desain (lihat laporan-review circuit: "OK lagi saat sesi jalan -> berhenti").
// 12 Nov 2026: tombol POWER (bit P0) sekarang ikut dibaca untuk PCB V2 (logika terbalik lewat Q4).
// Tombol yang sudah ditekan saat boot (POWER untuk menyalakan IP5306) diabaikan sampai dilepas.
// PCB V2: 6 tombol lewat PCF8574A (BUTTON_PINS = bit P0-P7). Index 5 = POWER (bit P0, logika terbalik).
static const uint8_t BUTTON_COUNT = 6;
static const uint8_t BUTTON_PINS[BUTTON_COUNT] = {
  BTN_UP, BTN_DOWN, BTN_OK, BTN_BACK, BTN_RIGHT, PCF_BIT_POWER
};
// Baca 1 byte penuh dari PCF8574 (P0-P7 sekaligus). Gagal baca (I2C error) dianggap
// "semua tombol tidak ditekan" (0xFF) supaya aman -- tidak ada tombol nyangkut ke-trigger terus.
static uint8_t pcf8574ReadV36(){
  Wire.requestFrom((int)pcfAddrV36,(int)1,(int)true);
  if(Wire.available())return Wire.read();
  return 0xFF;
}

bool buttonLastRaw[BUTTON_COUNT] = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};
bool buttonStable[BUTTON_COUNT] = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};
bool buttonLongSent[BUTTON_COUNT] = {false};
uint32_t buttonChangedAt[BUTTON_COUNT] = {0};
uint32_t buttonPressedAt[BUTTON_COUNT] = {0};
static const uint32_t BUTTON_LONG_PRESS_MS_V31 = 2000UL;

enum ButtonEventBits : uint8_t {
  BUTTON_EVENT_NONE  = 0,
  BUTTON_EVENT_SHORT = 1,
  BUTTON_EVENT_LONG  = 2
};

// V36.2: byte PCF8574 dibaca SEKALI per loop (pcfRefreshV36), bukan 5x transaksi I2C per loop.
static uint8_t pcfStateV36 = 0xFF;
static void pcfRefreshV36() { pcfStateV36 = pcf8574ReadV36(); }
// Hasil: HIGH = lepas, LOW = ditekan. POWER (index 5) dibalik karena lewat Q4 (lihat PCF_POWER_ACTIVE_HIGH).
static bool buttonRawV36(uint8_t index) {
  const bool level = (pcfStateV36 >> BUTTON_PINS[index]) & 0x01;
  return (index == 5 && PCF_POWER_ACTIVE_HIGH) ? !level : level;
}

uint8_t updateButtonEvent(uint8_t index) {
  const bool rawState = buttonRawV36(index);
  const uint32_t now = millis();
  uint8_t event = BUTTON_EVENT_NONE;
  if (rawState != buttonLastRaw[index]) { buttonLastRaw[index] = rawState; buttonChangedAt[index] = now; }
  if ((now - buttonChangedAt[index] >= 35UL) && buttonStable[index] != rawState) {
    buttonStable[index] = rawState;
    if (rawState == LOW) { buttonPressedAt[index] = now; buttonLongSent[index] = false; }
    else if (!buttonLongSent[index] && now - buttonPressedAt[index] >= 35UL) event |= BUTTON_EVENT_SHORT;
  }
  if (buttonStable[index] == LOW && !buttonLongSent[index] && now - buttonPressedAt[index] >= BUTTON_LONG_PRESS_MS_V31) {
    buttonLongSent[index] = true; event |= BUTTON_EVENT_LONG;
  }
  return event;
}

// 13 Nov 2026 -- ubah nilai dengan tombol ditahan (layar atur jarak / target speed).
// Tekan singkat = 1 langkah. Ditahan > 0,45 s = berulang tiap 80 ms; makin lama ditahan langkahnya
// membesar (1 -> 10 -> 50) supaya 1..2000 m cepat dicapai tapi tetap bisa tepat per 1 m.
// Mengembalikan jumlah langkah untuk loop ini (0 kalau tidak ada).
static uint32_t buttonRepeatAtV37[BUTTON_COUNT] = {0};
static uint16_t buttonHoldStepsV37(uint8_t index) {
  if (buttonStable[index] != LOW) { buttonRepeatAtV37[index] = 0; return 0; }
  const uint32_t now = millis(), held = now - buttonPressedAt[index];
  if (held < 450UL) { buttonRepeatAtV37[index] = 0; return 0; }
  if (buttonRepeatAtV37[index] == 0 && buttonLongSent[index]) return 0;   // tekanan ini sudah dipakai event lain
  if (buttonRepeatAtV37[index] != 0 && now - buttonRepeatAtV37[index] < 80UL) return 0;
  buttonRepeatAtV37[index] = now;
  buttonLongSent[index] = true;   // sudah dipakai sebagai "tahan" -> tidak ada event SHORT/LONG saat dilepas
  return held < 1500UL ? 1 : (held < 3500UL ? 10 : 50);
}

