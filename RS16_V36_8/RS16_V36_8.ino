// d = 'h' (DRAG) atau 'c' (CIRCUIT), rs = ukuran 1 rekaman
static void scanDatesV38(char d,size_t rs){
  runDateCountV38=0;if(!runFsOkV38)return;
  char dn[4]={'/',d,0,0};
  File dir=LittleFS.open(dn);if(!dir||!dir.isDirectory())return;
  File f=dir.openNextFile();
  while(f){
    const char* nm=f.name();const char* b=strrchr(nm,'/');b=b?b+1:nm;
    uint32_t v=0;uint8_t k=0;while(k<8&&b[k]>='0'&&b[k]<='9'){v=v*10+(b[k]-'0');k++;}
    if(k==8&&f.size()>=rs&&runDateCountV38<RUNLOG_MAX_DATES_V38)runDatesV38[runDateCountV38++]=v;
    f.close();f=dir.openNextFile();
  }
  dir.close();
  for(uint8_t i=1;i<runDateCountV38;i++){uint32_t x=runDatesV38[i];int16_t j=i-1;while(j>=0&&runDatesV38[j]>x){runDatesV38[j+1]=runDatesV38[j];j--;}runDatesV38[j+1]=x;}
}
