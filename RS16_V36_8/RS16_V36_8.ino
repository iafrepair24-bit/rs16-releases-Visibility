// 13 Nov 2026: GRAFIK "RUN n - SPEED vs DISTANCE" (desain user): jarak dihitung dari integrasi
// kecepatan di titik grafik, diskalakan ke jarak terukur; garis putus-putus = target, titik = akhir run.
static void drawSpeedDistGraphV37(const uint16_t* spd,const uint16_t* t10,uint16_t n,float maxKmh,float distM,float targetM,uint16_t runNo,const char* footer){
  fillScreen(C_V31_BG);drawTopBarV31();
  char v[32];
  if(runNo)snprintf(v,sizeof(v),"RUN %u - SPEED vs DISTANCE",(unsigned)runNo);else snprintf(v,sizeof(v),"SPEED vs DISTANCE");
  drawTextCenteredV31(160,36,v,C_V31_BLUE,textWidthV31(v,2)<=310?2:1);
  const int16_t x0=44,x1=296,yT=64,yB=192,w=x1-x0,hgt=yB-yT;
  if(n<2){drawTextCenteredV31(160,120,"DATA GRAFIK BELUM ADA",C_V31_GRAY,1);if(footer)drawTextRightV31(312,229,footer,C_V31_GRAY,1);return;}
  // jarak kumulatif dari kecepatan (trapesium)
  static float dd[DTRACE_MAX_V36];
  dd[0]=0;for(uint16_t i=1;i<n;i++){const float dt=(t10[i]>=t10[i-1]?(t10[i]-t10[i-1]):0)*0.01f;dd[i]=dd[i-1]+(spd[i-1]+spd[i])*0.05f/3.6f*dt;}
  if(dd[n-1]>0.5f&&distM>0.5f){const float k=distM/dd[n-1];for(uint16_t i=0;i<n;i++)dd[i]*=k;}
  float xmax=max(dd[n-1],targetM);if(xmax<10.0f)xmax=10.0f;
  const float vmax=spdDispV36(maxKmh);
  const uint16_t vstep=vmax>200?80:(vmax>120?40:(vmax>60?20:10));
  uint16_t vtop=(uint16_t)(ceilf(vmax/vstep)*vstep);if(vtop<vstep)vtop=vstep;
  drawTextV31(4,yT-12,unitMphV31?"mph":"kph",C_V31_GRAY,1);
  for(uint16_t sv=0;sv<=vtop;sv+=vstep){const int16_t y=yB-(int16_t)((float)sv/vtop*hgt);drawHLineV31(x0,y,w,C_V31_EDGE);snprintf(v,sizeof(v),"%u",sv);drawTextRightV31(x0-4,y-3,v,C_V31_GRAY,1);}
  drawVLineV31(x0,yT,hgt+1,C_V31_GRAY);
  // label sumbu jarak (5 titik)
  for(uint8_t k=0;k<=4;k++){const float dv=xmax*k/4.0f;const int16_t x=x0+(int16_t)(w*k/4);snprintf(v,sizeof(v),"%.0f",dv);drawTextCenteredV31(x,yB+5,v,C_V31_GRAY,1);}
  drawTextCenteredV31(x0+w/2,yB+18,"DISTANCE (m)",C_V31_GRAY,1);
  // garis target putus-putus
  if(targetM>0.0f){const int16_t xt=x0+(int16_t)(targetM/xmax*w);for(int16_t y=yT;y<yB;y+=6)drawVLineV31(xt,y,3,C_V31_BLUE);snprintf(v,sizeof(v),"%.0fm",targetM);drawTextRightV31(min((int16_t)312,(int16_t)(xt+16)),yT-12,v,C_V31_WHITE,1);}
  auto px=[&](uint16_t i)->int16_t{return x0+(int16_t)(dd[i]/xmax*w);};
  auto py=[&](uint16_t i)->int16_t{float s=spdDispV36(spd[i]*0.1f);if(s>vtop)s=vtop;return yB-(int16_t)(s/vtop*hgt);};
  for(uint16_t i=1;i<n;i++){drawLineV31(px(i-1),py(i-1),px(i),py(i),C_V31_BLUE);drawLineV31(px(i-1),py(i-1)-1,px(i),py(i)-1,C_V31_BLUE);}
  drawRingV36(px(n-1),py(n-1),4,2,C_V31_BLUE);
  snprintf(v,sizeof(v),"MAX %.1f",vmax);drawTextV31(x0+6,yT+4,v,C_V31_WHITE,1);
  if(footer)drawTextRightV31(312,229,footer,C_V31_GRAY,1);
}
// GRAFIK RUN: atas = kecepatan vs waktu (biru), bawah = G longitudinal (hijau = aksel, merah = rem).
