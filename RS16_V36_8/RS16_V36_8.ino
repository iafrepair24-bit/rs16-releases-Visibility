  const float prevD=max(0.0f,dragRtV31.prevRawDistanceM-(dragRolloutEnabled?0.3048f:0));
  const float d=max(0.0f,dragRtV31.rawDistanceM-(dragRolloutEnabled?0.3048f:0));
