static void drawTwinStripV38(const char* title,const char* name,const int8_t* a,const int8_t* b,float scaleA,float scaleB,float limA,float limB,
                             const char* labA,const char* labB,const char* topA,const char* botA,const char* topB,const char* botB,const char* unit,const char* footer){
