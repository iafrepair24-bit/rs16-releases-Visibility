// ---------- V36.8 layar PILIH MODE DRAG: ikon khas RS16 (tanpa lingkaran), latar gradasi + sorot biru ----------
#define RGB_V40(r,g,b) ((uint16_t)((((r)&0xF8)<<8)|(((g)&0xFC)<<3)|((b)>>3)))
// poligon terisi (boleh cekung, maks 8 titik): scanline genap-ganjil
static void fillPolyV40(const float* xy,uint8_t n,uint16_t c){
  if(n<3||n>8)return;
  float ymin=xy[1],ymax=xy[1];for(uint8_t k=1;k<n;k++){if(xy[2*k+1]<ymin)ymin=xy[2*k+1];if(xy[2*k+1]>ymax)ymax=xy[2*k+1];}
  for(int16_t y=(int16_t)floorf(ymin);y<=(int16_t)ceilf(ymax);y++){
    const float sy=y+0.5f;float xs[8];uint8_t m=0;
    for(uint8_t k=0;k<n;k++){
      const float x0=xy[2*k],y0=xy[2*k+1],x1=xy[2*((k+1)%n)],y1=xy[2*((k+1)%n)+1];
      if((y0<=sy&&y1>sy)||(y1<=sy&&y0>sy))xs[m++]=x0+(sy-y0)/(y1-y0)*(x1-x0);
    }
    for(uint8_t a=1;a<m;a++){const float v=xs[a];int8_t b=a-1;while(b>=0&&xs[b]>v){xs[b+1]=xs[b];b--;}xs[b+1]=v;}
    for(uint8_t a=0;a+1<m;a+=2){const int16_t xa=(int16_t)lroundf(xs[a]),xb=(int16_t)lroundf(xs[a+1]);if(xb>xa)fillRect(xa,y,xb-xa,1,c);}
  }
}
static void fillBoxV40(float cx,float cy,float s,float x0,float y0,float x1,float y1,uint16_t c){
  const int16_t a=(int16_t)lroundf(cx+x0*s),b=(int16_t)lroundf(cy+y0*s),w=(int16_t)lroundf(cx+x1*s)-a,h=(int16_t)lroundf(cy+y1*s)-b;
  fillRect(a,b,w<1?1:w,h<1?1:h,c);
}
// latar: gradasi gelap dari atas ke bawah + sorot biru lonjong di belakang ikon tengah
static void drawDragBackdropV40(){
  for(int16_t y=32;y<240;y++){
    const float t=y/240.0f,dy=(y-112)/72.0f;
    int16_t run=0;uint16_t rc=0;
    for(int16_t x=0;x<=320;x++){
      uint16_t c=0;
      if(x<320){
        const float dx=(x-160)/112.0f;float q=1.0f-(dx*dx+dy*dy);if(q<0)q=0;
        const uint8_t gq=(uint8_t)(q*q*16.0f);           // 0..16 tingkat sorot
        c=RGB_V40((uint8_t)(4+6*t),(uint8_t)(6+9*t+gq*3.3f),(uint8_t)(14+20*t+gq*6.6f));
      }
      if(x==320||(x>run&&c!=rc)){fillRect(run,y,x-run,1,rc);run=x;}
      rc=c;
    }
  }
}
// ikon mode. (cx,cy) = pusat, s = skala (1 = 60 x 44 px). c1 = warna utama, c2 = warna aksen
static void drawDragIconV40(uint8_t kind,float cx,float cy,float s,uint16_t c1,uint16_t c2,uint16_t cDim,uint16_t cMid){
  if(kind==0){          // DISTANCE: tiang start & finish + panah
    fillBoxV40(cx,cy,s,-30,-20,-25,20,c1);fillBoxV40(cx,cy,s,25,-20,30,20,c2);
    fillBoxV40(cx,cy,s,-18,-4,6,4,c1);
    const float p[6]={cx+4*s,cy-13*s,cx+19*s,cy,cx+4*s,cy+13*s};fillPolyV40(p,3,c1);
  }else if(kind==1){    // SPEED: tiga panah miring makin terang
    const uint16_t cc[3]={cDim,cMid,c2};
    for(uint8_t k=0;k<3;k++){
      const float x=-28+k*19;
      const float p[12]={cx+x*s,cy-20*s,cx+(x+10)*s,cy-20*s,cx+(x+22)*s,cy,cx+(x+10)*s,cy+20*s,cx+x*s,cy+20*s,cx+(x+12)*s,cy};
      fillPolyV40(p,6,cc[k]);
    }
  }else{                // 1/4 & 1/8 MILE: bendera kotak-kotak (1/8 = dua warna)
    fillBoxV40(cx,cy,s,-30,-22,-26,22,c1);
    for(uint8_t r=0;r<3;r++)for(uint8_t c=0;c<5;c++){
      if((r+c)&1)continue;
      const float x=-24+c*11,y=-20+r*9+c*1.2f;
      const float p[8]={cx+x*s,cy+y*s,cx+(x+11)*s,cy+(y+1.2f)*s,cx+(x+11)*s,cy+(y+10.2f)*s,cx+x*s,cy+(y+9)*s};
      fillPolyV40(p,4,(kind==2||c<3)?c2:c1);
    }
  }
}
