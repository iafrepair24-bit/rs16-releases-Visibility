static uint8_t dragReadyLastReasonV33=255;
static uint32_t dragReadyLastRefreshV33=0;

static void serviceDragReadyUiV33(){
  if(uiTestScreen!=UI_DRAG_READY)return;
  const uint32_t now=millis();
  if(now-dragReadyLastRefreshV33<350UL)return;
  dragReadyLastRefreshV33=now;

  uint8_t reason=gpsTimingReasonV33();
  if(reason!=dragReadyLastReasonV33){
    dragReadyLastReasonV33=reason;
    drawDragStandbyV31();
  }else{
    // Only refresh top status values. Dengan framebuffer: gambar ulang lewat FB (hanya baris berubah terkirim).
    if(fbV36)drawDragStandbyV31();else drawTopBarStatusOnlyV32();
  }
}

static uint32_t lastTopBarOnlyMsV31=0;
static void serviceTopBarOnlyV31(){
  if(periodicUiV31()) return;
  const uint32_t now=millis();
  if(now-lastTopBarOnlyMsV31<1000UL) return;
  lastTopBarOnlyMsV31=now;
  if(fbV36&&uiFbScreenV36()){screenDirtyV31=true;return;}   // V36.2: jam/baterai ikut lewat framebuffer
  if(fbV36){
    // layar bergambar: jam/baterai/sinyal diperbarui dengan menggambar ulang lewat framebuffer (tanpa kedip)
    if(gpsLockPopupUntilV36||powerAskV40)return;   // popup GPS sedang tampil di atas menu
    switch(uiTestScreen){
      case UI_MAIN_MENU:drawSelectedMenu(selectedMenu);return;
      case UI_DRAG_PAGE1:drawSelectedDragPage1V31();return;
      case UI_DRAG_PAGE2:drawSelectedDragPage2V31();return;
      case UI_CIRCUIT_MENU:drawSelectedCircuitMenuV31();return;
      case UI_ACCEL_MENU:drawSelectedAccelerationMenuV31();return;
      case UI_ACCEL_CAL_MENU:drawSelectedImuCalMenuV31();return;
      case UI_DRAG_READY:return;      // ditangani serviceDragReadyUiV33()
      default:break;
    }
  }
  drawTopBarStatusOnlyV32();
}

static bool activeMeasurementV31(){return uiTestScreen==UI_DRAG_RUNNING||uiTestScreen==UI_CIRCUIT_RUNNING||uiTestScreen==UI_GPS_LOGGER_RECORDING||otaInProgressV31;}
static void serviceAutoShutdownV31(){uint8_t mins=AUTO_SHUTDOWN_MINUTES_V31[autoShutdownIndexV31];if(!mins||activeMeasurementV31()||displaySleepingV31)return;bool moving=gpsSpeedKmhV30>1.0f||fabsf(gLongV31)>0.12f||fabsf(gLatV31)>0.12f;if(moving){lastActivityMsV31=millis();return;}if(millis()-lastActivityMsV31>mins*60000UL){powerOffV36("AUTO SHUTDOWN");}}
// FIX 6 Sep 2026: dulu gpsSpeedKmhV30 tidak pernah di-nol-kan saat sinyal GPS hilang, jadi layar
// (Circuit / GPS Logger / speedometer) tetap menampilkan angka kecepatan terakhir seolah masih live
// padahal PVT sudah berhenti -- menyesatkan saat masuk terowongan atau kehilangan fix.
// Aman untuk engine pengukuran: serviceDragV31()/serviceCircuitV31()/serviceLoggerV31() hanya
// bekerja saat ada paket PVT BARU (dijaga pembanding nomor urut), jadi nilai nol ini tidak akan
// pernah ikut terhitung sebagai data race.
static void serviceGpsStaleSpeedV36(){
  if(gpsLastPvtMillisV30==0)return;
  if(millis()-gpsLastPvtMillisV30>1500UL && gpsSpeedKmhV30!=0.0f){gpsSpeedKmhV30=0.0f;screenDirtyV31=true;}
}

static void serviceGpsRecoveryV32(){
  if(activeMeasurementV31())return;
  const uint32_t now=millis();
  const bool noPvt=(gpsLastPvtMillisV30==0 || now-gpsLastPvtMillisV30>6000UL);
  const bool noBytes=(gpsLastByteMillisV32==0 || now-gpsLastByteMillisV32>5000UL);

  if(noBytes){
    if(now-gpsLastAutoDetectMillisV32>15000UL){
      gpsLastAutoDetectMillisV32=now;
      Serial.println("GNSS UART LOST - background scan disabled");
    }
    return;
  }

  if(noPvt && now-gpsLastAutoDetectMillisV32>10000UL){
    gpsLastAutoDetectMillisV32=now;
    configureGnssRateMsgsV36();
    Serial.println("GNSS PVT RECOVERY - rate config resent");
  }
}

// Diagnosa layar putih: "lcd" = reset + init ulang LCD lalu tampil MERAH, HIJAU, BIRU, PUTIH, HITAM
// (masing-masing 0,6 s). "lcd 10" = sama, tapi SPI LCD diturunkan ke 10 MHz (juga "lcd 4", "lcd 20").
// Warna muncul -> hardware LCD OK. Tetap putih -> sambungan FPC LCD / pin RST,DC,CS,SCK,MOSI.
static void lcdSelfTestV36(uint32_t mhz){
  if(mhz>=1&&mhz<=40)LCD_SPI_HZ=mhz*1000000UL;
  Serial.printf("LCD TEST: SPI %lu MHz, RST=%d DC=%d CS=%d SCK=%d MOSI=%d\n",(unsigned long)(LCD_SPI_HZ/1000000UL),TFT_RST,TFT_DC,TFT_CS,TFT_SCLK,TFT_MOSI);
  lcdInit();
  const uint16_t c[5]={0xF800,0x07E0,0x001F,0xFFFF,0x0000};const char* n[5]={"MERAH","HIJAU","BIRU","PUTIH","HITAM"};
  for(uint8_t i=0;i<5;i++){fillScreen(c[i]);Serial.printf("LCD TEST: %s\n",n[i]);delay(600);}
  if(uiTestScreen==UI_MAIN_MENU)drawSelectedMenu(selectedMenu);
  screenDirtyV31=true;
  Serial.println("LCD TEST selesai. Warna tampil = LCD & sambungan OK.");
}
static void serviceSerialCommandsV31(){static String cmd;while(Serial.available()){char c=Serial.read();if(c=='\n'||c=='\r'){cmd.trim();if(cmd=="status")Serial.printf("V32 GPS=%.1fHz SAT=%u USED=%u FIX=%u RX=%lu PVT=%lu ERR=%lu BAUD=%lu HACC=%.2f SACC=%.2f IMU=%s BAT=%.2f SD=%s\n",gpsActualRateHzV30,(unsigned)(gpsSatellitesV30?gpsSatellitesV30:gpsSatViewCountV32),(unsigned)gpsSatUsedV31,(unsigned)gpsFixTypeV30,(unsigned long)gpsBytesRxV30,(unsigned long)gpsPvtPacketsV30,(unsigned long)gpsChecksumErrorsV30,(unsigned long)gpsActiveBaudV32,gpsHorizontalAccuracyM_V30,gpsSpeedAccuracyKmhV30,imuConnectedV31?"OK":"NO",batteryVoltageV31,sdReadyV31?"OK":"NO");else if(cmd=="gnss 25hz")configureMg90225HzV30();else if(cmd=="imu zero")startImuCalV31(2);else if(cmd=="gps"){const bool ok=detectAndConfigureGpsV32();Serial.printf("GPS %s  UART RX=GPIO%d TX=GPIO%d baud=%lu  byte diterima=%lu  (bytes 0 = modul GPS tidak mengirim: cek daya 5V & kabel)\n",ok?"TERDETEKSI":"TIDAK ADA DATA",gpsRxPinV37,gpsTxPinV37,(unsigned long)gpsActiveBaudV32,(unsigned long)gpsBytesRxV30);}else if(cmd=="imu"){imuConnectedV31=false;initImuV31();Serial.printf("IMU %s %s mode%u  WHO mode3 ICM=0x%02X LSM=0x%02X mode0 ICM=0x%02X LSM=0x%02X  (00/FF = chip tidak menjawab)\n",imuChipNameV36(),imuConnectedV31?"OK":"TIDAK ADA",imuSpiModeV37==SPI_MODE3?3:0,imuDiagIcmV37[0],imuDiagLsmV37[0],imuDiagIcmV37[1],imuDiagLsmV37[1]);}else if(cmd=="i2c"){Serial.print("I2C:");uint8_t n=0;for(uint8_t a=1;a<127;a++){Wire.beginTransmission(a);if(Wire.endTransmission()==0){Serial.printf(" 0x%02X",a);n++;}}Serial.printf("  (%u perangkat; PCF tombol=0x%02X, IMU MPU 0x68/69, LSM 0x6A/6B, GPS 0x42)\n",n,pcfAddrV36);}else if(cmd.startsWith("lcd"))lcdSelfTestV36(cmd.length()>4?(uint32_t)cmd.substring(4).toInt():0);else if(cmd=="btn"){pcfRefreshV36();Serial.printf("BTN PCF=0x%02X byte=0x%02X UP=%u DOWN=%u OK=%u BACK=%u RIGHT=%u POWER=%u (0=ditekan) IMU=%s\n",(unsigned)pcfAddrV36,(unsigned)pcfStateV36,buttonRawV36(0),buttonRawV36(1),buttonRawV36(2),buttonRawV36(3),buttonRawV36(4),buttonRawV36(5),imuChipNameV36());}else if(cmd=="wifi on")startWifiV31();else if(cmd=="wifi off")stopWifiV31();cmd="";}else if(cmd.length()<64)cmd+=c;}}

// PENANDA BOOT (ditambahkan 6 Sep 2026) -- setiap langkah setup() mencetak satu baris ke Serial.
// Tujuannya: kalau board macet/reset saat boot, baris terakhir yang muncul langsung menunjukkan
// langkah mana yang jadi biang keroknya. Tidak ada kaitan dengan tampilan/LCD.
#define BOOTMARK_V36(step) do{ Serial.print("BOOT> "); Serial.println(step); Serial.flush(); }while(0)

void setup(){
  rtc_gpio_deinit((gpio_num_t)PCF_INT_PIN);   // lepas mode RTC sisa deep sleep -> GPIO biasa lagi
  Serial.begin(115200);delay(100);
  Serial.println();
  BOOTMARK_V36("00 serial hidup");
  Serial.printf("BOOT> reset reason=%d  cpu=%d MHz  heap=%u\n",
                (int)esp_reset_reason(),(int)getCpuFrequencyMhz(),(unsigned)ESP.getFreeHeap());
  Serial.flush();
  pinMode(TFT_CS,OUTPUT);pinMode(TFT_DC,OUTPUT);pinMode(TFT_RST,OUTPUT);digitalWrite(TFT_CS,HIGH);digitalWrite(TFT_DC,HIGH);digitalWrite(TFT_RST,HIGH);
  pinMode(TFT_BL_PIN,OUTPUT);digitalWrite(TFT_BL_PIN,LOW);   // V36.8: backlight MATI dulu -- dinyalakan setelah logo opening tergambar (dulu ON di sini = layar putih 1-2 s)
  BOOTMARK_V36("01 pin TFT siap");
  pinMode(ICM_CS_PIN,OUTPUT);digitalWrite(ICM_CS_PIN,HIGH);   // IMU ICM-42688-P share bus SPI dengan TFT, CS sendiri
  pinMode(FLASH_CS_PIN,OUTPUT);digitalWrite(FLASH_CS_PIN,HIGH); // flash U7 dijamin non-aktif -- jangan sampai ikut mendorong SPI_MISO
  pinMode(RS16_SD_CS_PIN,OUTPUT);digitalWrite(RS16_SD_CS_PIN,HIGH); // microSD CS non-aktif sampai initSdV31()
  BOOTMARK_V36("02 pin CS IMU + flash siap");
  lcdSPI.begin(TFT_SCLK,TFT_MISO,TFT_MOSI,TFT_CS);   // bus SPI dinyalakan duluan -- dipakai IMU di initImuV31() di bawah
  BOOTMARK_V36("04 SPI hidup");
  fbV36=(uint8_t*)heap_caps_malloc((size_t)LCD_W*LCD_H,MALLOC_CAP_8BIT);
  Serial.printf("BOOT> 04b framebuffer %s (heap %u)\n",fbV36?"OK":"GAGAL -> gambar langsung",(unsigned)ESP.getFreeHeap());
  Wire.begin(MPU_SDA_PIN_V31,MPU_SCL_PIN_V31,100000);  // V36.2: PCF8574/PCF8574A maks 100 kHz (dulu 400 kHz, di luar spek)  // I2C sekarang cuma untuk PCF8574 (tombol)
  BOOTMARK_V36("05 I2C hidup");
  uint8_t pcfErr=0xFF;
  {
    // cari PCF8574A (0x38-0x3F) dulu, lalu PCF8574 (0x20-0x27). Tulis 0xFF = semua pin jadi input.
    static const uint8_t base[2]={0x38,0x20};
    for(uint8_t b=0;b<2&&pcfErr!=0;b++)for(uint8_t a=0;a<8&&pcfErr!=0;a++){
      Wire.beginTransmission(base[b]+a);Wire.write(0xFF);
      if(Wire.endTransmission()==0){pcfAddrV36=base[b]+a;pcfErr=0;}
    }
  }
  Serial.printf("BOOT> 06 PCF8574%s 0x%02X -> %s\n",pcfAddrV36>=0x38?"A":"",pcfAddrV36,pcfErr==0?"TERDETEKSI":"TIDAK MENJAWAB (tombol tidak akan berfungsi)");
  if(pcfErr!=0){Serial.print("BOOT> I2C scan:");for(uint8_t a=1;a<127;a++){Wire.beginTransmission(a);if(Wire.endTransmission()==0)Serial.printf(" 0x%02X",a);}Serial.println();}
  Serial.flush();
  pinMode(BUZZER_PIN_V31,OUTPUT);digitalWrite(BUZZER_PIN_V31,LOW);
  pinMode(GPS_LED_PIN_V40,OUTPUT);digitalWrite(GPS_LED_PIN_V40,LOW);   // V36.8 LED GPS padam saat boot
  pinMode(BATTERY_ADC_PIN_V31,INPUT);analogReadResolution(12);analogSetPinAttenuation(BATTERY_ADC_PIN_V31,ADC_11db);
  BOOTMARK_V36("07 buzzer + ADC baterai siap");
  delay(5);   // pull-up tombol stabil dulu
  pcfRefreshV36();
  for(uint8_t i=0;i<BUTTON_COUNT;i++){bool s=buttonRawV36(i);buttonLastRaw[i]=s;buttonStable[i]=s;buttonChangedAt[i]=millis();buttonLongSent[i]=false;
    // tombol yang masih ditekan saat boot (mis. POWER yang ditahan untuk menyalakan) diabaikan
    // sampai dilepas -- kalau tidak, tahan >2 dtk langsung terbaca LONG = power off lagi.
    if(s==LOW)buttonLongSent[i]=true;
  }
  Serial.printf("BOOT> 08 tombol dibaca, byte tombol = 0x%02X  (UP=%u DOWN=%u OK=%u BACK=%u RIGHT=%u POWER=%u, 0=ditekan)\n",
                (unsigned)pcfStateV36,buttonRawV36(0),buttonRawV36(1),buttonRawV36(2),buttonRawV36(3),buttonRawV36(4),buttonRawV36(5));
  Serial.flush();
  // FIX 6 Sep 2026: applyGnssUpdateRateV36()/applyGnssSystemV36() TIDAK dipanggil di sini lagi.
  // Dulu dipanggil di baris ini -- padahal gpsSerial.begin() baru terjadi di dalam
  // detectAndConfigureGpsV32() beberapa baris di bawah, jadi command UBX-nya dikirim ke
  // UART yang belum aktif dan hilang diam-diam. Sekarang setting user diterapkan di
  // configureMg90225HzV30() yang dipanggil dari detectAndConfigureGpsV32() (UART sudah hidup).
  prefsV31.begin("rs16v31",false);BOOTMARK_V36("09 NVS/preferences terbuka");
  loadSettingsV31();loadCompareV36();BOOTMARK_V36("10 setting dimuat");
  initImuV31();Serial.printf("BOOT> 11 IMU = %s (%s)  SPI WHO mode3: ICM=0x%02X LSM=0x%02X  mode0: ICM=0x%02X LSM=0x%02X\n",imuChipNameV36(),imuConnectedV31?"TERDETEKSI":"TIDAK TERDETEKSI",imuDiagIcmV37[0],imuDiagLsmV37[0],imuDiagIcmV37[1],imuDiagLsmV37[1]);Serial.flush();
  // V36.8: LCD di-init & logo opening digambar SEBELUM backlight dinyalakan -> tidak ada layar putih.
  // Sengaja SETELAH deteksi IMU: sebelum dikonfigurasi, IMU bisa membaca trafik LCD di SCK/MOSI sebagai I2C.
  lcdInit();fillScreen(C_BLACK);drawRs16OpeningBitmap();setBacklightV36(true);
  const uint32_t openingShownMsV40=millis();
  BOOTMARK_V36("13 LCD di-init + logo opening tampil");
  updateBatteryV31(true);Serial.printf("BOOT> 12 baterai = %.2f V\n",batteryVoltageV31);Serial.flush();
  // V36.8: cek cepat 115200 saja (modul yang sudah dikonfigurasi langsung terbaca); kalau belum ada,
  // pencarian baud lain berjalan di latar belakang -- opening tidak ikut tertahan.
  if(sniffGpsBaudV32(115200UL,350)){gpsConfigureFoundV40();}
  else{Serial.println("GNSS: belum terbaca di 115200, dicari di latar belakang");gpsScanBeginV40(0);}
  BOOTMARK_V36("15 GPS dicek");
  initSdV31();runLogInitV38();BOOTMARK_V36("16 storage dicek");
  while(millis()-openingShownMsV40<1000UL)delay(10);   // V36.8: logo tampil minimal 1 s
  drawSelectedMenu(selectedMenu);lastActivityMsV31=millis();BOOTMARK_V36("17 menu utama digambar");
  Serial.println("RS16 V36 READY - ALL MENU ACTIONS / LIVE DATA / STABLE GNSS");Serial.printf("GNSS MG-902 UBX 25Hz, IMU %s 200Hz, RAW SPI ILI9341\n",imuChipNameV36());Serial.println(RS16_SD_ENABLED?"MICROSD COMPILE ENABLED":"MICROSD SLOT EXISTS; SET SD GPIO MAP TO ENABLE WRITES");
}

// V36.8: modul tidak sanggup 0,04 s untuk sistem satelit yang dipilih -> turun otomatis ke 0,06 s
static void serviceGnssRateAutoV40(){
  static uint32_t lowSince=0;
  if(gnssSlowV40()||gnssRateFellBackV40||activeMeasurementV31()){lowSince=0;return;}
  const bool fixOk=gpsFixTypeV30>=3&&gpsLastPvtMillisV30&&millis()-gpsLastPvtMillisV30<500UL;
  if(!fixOk||gpsActualRateHzV30<=0.5f||gpsActualRateHzV30>=21.5f){lowSince=0;return;}
  if(!lowSince){lowSince=millis();return;}
  if(millis()-lowSince<6000UL)return;
  gnssMeasAutoV40=60;gnssRateFellBackV40=true;lowSince=0;
  Serial.printf("GNSS: rate terukur %.1f Hz < 25 Hz untuk %s -> otomatis 0,06 s\n",gpsActualRateHzV30,GNSS_SYSTEM_NAME_V36[gnssSystemIdxV36<5?gnssSystemIdxV36:4]);
  configureGnssRateMsgsV36();screenDirtyV31=true;
}
static void serviceGpsLedV40(){
  static int8_t last=-1;
  const int8_t on=(gpsTimingReadyV31()&&!displaySleepingV31)?1:0;
  if(on!=last){last=on;digitalWrite(GPS_LED_PIN_V40,on?HIGH:LOW);}
}
static void gpsOnPvtSampleV40(){
  serviceDragV31();serviceDragFinishFreezeV36();serviceCircuitV31();serviceLoggerV31();
}
