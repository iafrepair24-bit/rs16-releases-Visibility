  bool ok=f.seek((uint32_t)idx*sizeof(RunLogV38))&&f.read((uint8_t*)&runLogV38,sizeof(RunLogV38))==sizeof(RunLogV38);
  f.close();return ok&&runLogV38.magic==RUNLOG_MAGIC_V38;
}
static void runLogMakeRoomV38(){
  uint32_t today=0;{uint8_t a1,b1,c1;localNowV38(&today,&a1,&b1,&c1);}
  for(uint8_t guard=0;guard<10;guard++){
    if(LittleFS.totalBytes()-LittleFS.usedBytes()>=(size_t)(1600*4+8192))return;
    scanDatesV38('h',1);const uint32_t oh=runDateCountV38?runDatesV38[0]:0xFFFFFFFFUL;
    scanDatesV38('c',1);const uint32_t oc=runDateCountV38?runDatesV38[0]:0xFFFFFFFFUL;
    const char d=(oh<=oc)?'h':'c';const uint32_t old=(oh<=oc)?oh:oc;
    if(old==0xFFFFFFFFUL||(today&&old==today))return;
    char pth[24];logPathV38(d,old,pth,sizeof(pth));LittleFS.remove(pth);
    Serial.printf("RIWAYAT: flash penuh, %s %08lu dihapus\n",d=='h'?"DRAG":"CIRCUIT",(unsigned long)old);
