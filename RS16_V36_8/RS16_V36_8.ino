#define HIST_SESS_N_V39 40
struct SessSumV39{uint32_t best;float fin;uint16_t sessNo;uint8_t daySess,runs,bestRun,mode,hh,mm;};
static SessSumV39 sessV39[HIST_SESS_N_V39];static uint8_t sessCntV39=0,sessSelV39=0;
static uint8_t histSessIdxV39[HIST_CACHE_N_V38];static uint8_t histSessCntV39=0;   // indeks run (di file) milik sesi terpilih, urut RUN 1,2,3..
static void histBuildSessV39(){
  sessCntV39=0;
  for(uint16_t i=0;i<histRunCountV38;i++){
    const RunSumV38& q=runSumV38[i];if(!q.daySess)continue;
    SessSumV39* p=nullptr;
    for(uint8_t k=0;k<sessCntV39;k++)if(sessV39[k].daySess==q.daySess){p=&sessV39[k];break;}
    if(!p){if(sessCntV39>=HIST_SESS_N_V39)continue;p=&sessV39[sessCntV39++];memset(p,0,sizeof(*p));p->daySess=q.daySess;p->sessNo=q.sessNo;p->mode=q.mode;p->fin=q.fin;p->hh=q.hh;p->mm=q.mm;}
    if(p->runs<255)p->runs++;
    if(q.completed&&q.total&&(!p->best||q.total<p->best)){p->best=q.total;p->bestRun=p->runs;}
  }
  if(sessSelV39>=sessCntV39)sessSelV39=0;
}
static const SessSumV39& histSessCurV39(){return sessV39[sessCntV39?sessCntV39-1-sessSelV39:0];}
static void histBuildSessRunsV39(){
  histSessCntV39=0;if(!sessCntV39)return;const uint8_t ds=histSessCurV39().daySess;
  for(uint16_t i=0;i<histRunCountV38;i++)if(runSumV38[i].daySess==ds)histSessIdxV39[histSessCntV39++]=(uint8_t)i;
}
