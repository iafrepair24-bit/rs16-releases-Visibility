// V36.6: BEST/LAST lama (4 titik) dipertahankan. Waktu total tetap; waktu checkpoint dipindah ke titik
// baru yang targetnya sama, titik baru yang dulu tidak ada diisi "--".
static void oldTargetsV38(uint8_t m,const uint16_t* oc,float o[4]){
  static const float T[DRAG_MODE_COUNT_V36][4]={{18.288f,100.0f,201.168f,402.336f},{18.288f,100.0f,150.0f,201.168f},{18.288f,0,0,0},{0,0,0,0},{20,50,80,100},{50,100,150,200},{0,0,0,0}};
  for(uint8_t i=0;i<4;i++)o[i]=T[m][i];
  if(m==DRAG_CUSTOM&&oc)for(uint8_t i=0;i<4;i++)o[i]=oc[i];
  if(m==DRAG_0_SPEED_0)o[0]=(float)speed0TargetKmh;
}
static void migrateCompareV38(const char* key,DragCompareV36* dst){
  struct OldV38{uint32_t cp[4];uint32_t total;};
  OldV38 old[DRAG_MODE_COUNT_V36];
  if(prefsV31.getBytesLength(key)!=sizeof(old))return;
  prefsV31.getBytes(key,old,sizeof(old));
  uint16_t oc[4];const bool haveOc=migrateCustomOldV38(oc);
  const DragModeId keep=selectedDragMode;
  for(uint8_t m=0;m<DRAG_MODE_COUNT_V36;m++){
    float ot[4],nt[DRAG_CP_N];oldTargetsV38(m,haveOc?oc:nullptr,ot);
    if(m==DRAG_CUSTOM&&!haveOc)for(uint8_t i=0;i<4;i++)ot[i]=(i<3)?customPointM[i]:customPointM[DRAG_CP_N-1];
    selectedDragMode=(DragModeId)m;dragTargetsV31(nt);
    dst[m].total=old[m].total;
    for(uint8_t i=0;i<DRAG_CP_N;i++){
      dst[m].cp[i]=0xFFFFFFFFUL;
      if(nt[i]<=0.0f)continue;
      for(uint8_t j=0;j<4;j++)if(ot[j]>0.0f&&fabsf(ot[j]-nt[i])<0.01f){dst[m].cp[i]=old[m].cp[j];break;}
    }
  }
  selectedDragMode=keep;fmtMigratedV38=true;
  prefsV31.putBytes(key,dst,sizeof(DragCompareV36)*DRAG_MODE_COUNT_V36);
  Serial.printf("SETTING: data %s lama dipindah ke format 5 titik\n",key);
}
static void loadCompareV36(){
  memset(dragBestV36,0,sizeof(dragBestV36));
  memset(dragLastV36,0,sizeof(dragLastV36));
  if(prefsV31.getBytesLength("cmpb")==sizeof(dragBestV36))prefsV31.getBytes("cmpb",dragBestV36,sizeof(dragBestV36));
  else migrateCompareV38("cmpb",dragBestV36);
  if(prefsV31.getBytesLength("cmpl")==sizeof(dragLastV36))prefsV31.getBytes("cmpl",dragLastV36,sizeof(dragLastV36));
  else migrateCompareV38("cmpl",dragLastV36);
  customSignatureV36=prefsV31.getUInt("cpsig",0);
  // mode CUSTOM: best/last hanya valid untuk kombinasi checkpoint yang sama persis
  uint32_t now=customSignatureCalcV36();
  if(fmtMigratedV38&&customSignatureV36!=now){ customSignatureV36=now; saveCompareV36(); }   // V36.6 pindah format: data tetap
  else if(customSignatureV36!=now){ clearCompareModeV36((uint8_t)DRAG_CUSTOM); customSignatureV36=now; saveCompareV36(); }
  // V36.7: tanda titik mode SPEED. Belum pernah disimpan (firmware lama, titik bawaan 20/40/60/80/100) -> pakai yang sekarang.
  {uint32_t h=2166136261UL;for(uint8_t i=0;i<DRAG_CP_N;i++){h^=speedPointKmh[i];h*=16777619UL;}
   if(!prefsV31.isKey("spsig")){speedSignatureV39=h;prefsV31.putUInt("spsig",h);}
   else{speedSignatureV39=prefsV31.getUInt("spsig",0);if(speedSignatureV39!=h){clearCompareModeV36((uint8_t)DRAG_0_100);speedSignatureV39=h;prefsV31.putUInt("spsig",h);saveCompareV36();}}}
}
