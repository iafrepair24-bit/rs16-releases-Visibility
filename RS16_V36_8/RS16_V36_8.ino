static bool localNowV38(uint32_t* ymd,uint8_t* hh,uint8_t* mi,uint8_t* ss){
  if(!gpsDateTimeValidV30||gpsYearV30<2020)return false;
  uint16_t y=gpsYearV30;uint8_t mo=gpsMonthV30,d=gpsDayV30;
  int32_t mins=(int32_t)gpsHourV30*60+gpsMinuteV30+RS16_TZ_OFFSET_MIN;
