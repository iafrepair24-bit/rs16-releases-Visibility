enum DsKindV39 : uint8_t { DSK_SESSION=0, DSK_PRIMARY, DSK_R1, DSK_R2, DSK_R3, DSK_R4, DSK_COMPARE, DSK_DISPLAY, DSK_ROLLOUT, DSK_FREEZE, DSK_START };
