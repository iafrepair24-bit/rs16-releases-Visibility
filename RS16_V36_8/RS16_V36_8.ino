// V36.1 proteksi baterai: matikan beban & tidurkan layar saat tegangan kritis (kecuali sedang OTA)
// V36.2 POWER OFF NYATA. Dulu "auto shutdown" & proteksi baterai cuma mengirim DISPLAY OFF (0x28)
// -- backlight tetap 3V3, GPS/ESP32 tetap jalan, baterai terus terkuras sampai habis.
// PCB V2 100x55 tidak punya latch daya (GPIO12 tidak tersambung): ESP32 masuk deep sleep, beban turun,
// IP5306 mematikan boost sendiri saat arus beban kecil. Bangun: tombol apa saja (PCF_INT -> GPIO13 LOW)
// atau POWER (KEY IP5306 menyalakan lagi -> boot normal).
static void powerOffV36(const char* reason){
  Serial.printf("POWER OFF: %s\n",reason);
  loggerStopV31();
  stopWifiV31();
  fillScreen(C_V31_BG);
  drawTextCenteredV31(160,100,"POWER OFF",C_V31_WHITE,3);
  drawTextCenteredV31(160,140,reason,C_V31_GRAY,1);
  if(soundFinishV31)buzzerPlayV31(1000,200);
  delay(1200);
  lcdCommand(0x28);
  Serial.flush();
  setBacklightV36(false);   // backlight padam (PCB V2: Q5 off)
  lcdCommand(0x10);   // ILI9341 SLEEP IN
  digitalWrite(GPS_LED_PIN_V40,LOW);pinMode(GPS_LED_PIN_V40,INPUT_PULLDOWN);   // V36.8 LED GPS padam saat deep sleep
  {const uint32_t t0=millis();do{pcfRefreshV36();delay(20);}while(buttonRawV36(5)==LOW&&millis()-t0<5000UL);}   // tunggu POWER dilepas
  delay(50);
  for(uint8_t i=0;i<5&&digitalRead(PCF_INT_PIN)==LOW;i++){pcfRefreshV36();delay(10);}   // baca PCF = INT dilepas
  pinMode(PCF_INT_PIN,INPUT);   // pull-up R9 10k di PCB
  esp_sleep_enable_ext0_wakeup((gpio_num_t)PCF_INT_PIN,0);
  Serial.println("POWER OFF: deep sleep, tekan tombol apa saja / POWER untuk menyalakan");Serial.flush();
  esp_deep_sleep_start();
}

