// ---- tabel split per 10 km/h (0-10, 0-20, ...): waktu + jarak, dihitung dari grafik tersimpan ----
static void drawHistSplitV39(const RunLogV38& r,const char* name){
  fillScreen(C_V31_BG);drawTopBarV31();char v[32];
  snprintf(v,sizeof(v),"RUN %u  %s",(unsigned)(histRunSelV38+1),name);drawTextV31(14,38,v,C_V31_GRAY,1);
  drawTextRightV31(306,38,unitMphV31?"MPH / DETIK / M":"KPH / DETIK / M",C_V31_BLUE,1);
  const HistTraceV37& h=r.tr;
  if(h.n<2){drawTextCenteredV31(160,112,"DATA TIDAK TERSIMPAN",C_V31_GRAY,1);drawTextRightV31(312,229,"RIGHT = GRAFIK",C_V31_GRAY,1);return;}
  const float unitK=unitMphV31?1.609344f:1.0f;
  const float vmaxD=spdDispV36(h.maxSpd10*0.1f);
  const uint16_t step=vmaxD>200.0f?20:10;
  for(uint8_t c=0;c<2;c++){const int16_t x=c?166:8;fillRect(x,50,146,13,C_V31_EDGE);drawTextV31(x+6,53,"SPEED",C_V31_WHITE,1);drawTextRightV31(x+96,53,"TIME",C_V31_WHITE,1);drawTextRightV31(x+142,53,"JARAK",C_V31_WHITE,1);}
  uint8_t row=0;uint16_t tgt=step;
  float v0=0,t0=0,d0=0;   // km/h, detik, meter
  for(uint16_t i=0;i<h.n&&row<20;i++){
    const float v1=h.spd[i]*0.1f,t1=h.t10[i]*0.01f;const float dt=t1>t0?t1-t0:0.0f;
    while(row<20&&v1>v0&&(float)tgt*unitK<=v1){
      const float tk=(float)tgt*unitK;const float f=(tk>v0)?(tk-v0)/(v1-v0):0.0f;
      const float tt=t0+f*dt,dd=d0+(v0+tk)*0.5f/3.6f*(f*dt);
      const int16_t x=(row<10)?8:166,y=67+(row%10)*15;
      char l[14];snprintf(l,sizeof(l),"0-%u",(unsigned)tgt);drawTextV31(x+6,y,l,C_V31_BLUE,1);
      snprintf(l,sizeof(l),"%.2f",tt);drawTextRightV31(x+96,y,l,C_V31_WHITE,1);
      snprintf(l,sizeof(l),"%.1f",dd);drawTextRightV31(x+142,y,l,C_V31_TEXT,1);
      row++;tgt+=step;
    }
    d0+=(v0+v1)*0.5f/3.6f*dt;v0=v1;t0=t1;
  }
  if(!row)drawTextCenteredV31(160,120,unitMphV31?"KECEPATAN BELUM MENCAPAI 10 MPH":"KECEPATAN BELUM MENCAPAI 10 KPH",C_V31_GRAY,1);
  drawVLineV31(160,50,166,C_V31_EDGE);
  snprintf(v,sizeof(v),"VMAX %.1f %s",vmaxD,spdUnitV36());drawTextV31(8,229,v,C_V31_GRAY,1);
  drawTextRightV31(312,229,"RIGHT = GRAFIK",C_V31_GRAY,1);
}
