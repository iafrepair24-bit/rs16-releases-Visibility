  drawSpeedDistGraphV37(dTraceSpdV36,dTraceTV36,dTraceCountV36,dragRtV31.maxSpeedKmh,dragFinishDistV37,tgtM,dragLastRunNoV37,"LEFT / RIGHT = HASIL");
