// V36.7: mode SPEED bebas -- BEST/LAST hanya berlaku untuk kombinasi titik kecepatan yang sama
static uint32_t speedSignatureCalcV39(){uint32_t h=2166136261UL;for(uint8_t i=0;i<DRAG_CP_N;i++){h^=speedPointKmh[i];h*=16777619UL;}return h;}
