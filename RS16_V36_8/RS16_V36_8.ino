static const uint32_t RS16_ACCELERATION_MENU_V24_RLE_COUNT =
  sizeof(RS16_ACCELERATION_MENU_V24_RLE) / sizeof(RS16_ACCELERATION_MENU_V24_RLE[0]);

void drawAccelerationMenuV24Bitmap() {
  if (fbActiveV36) { rleToFbV37((const uint16_t*)RS16_ACCELERATION_MENU_V24_RLE, RS16_ACCELERATION_MENU_V24_RLE_COUNT); return; }
  lcdStartWrite();
  lcdSetWindowTx(0, 0, LCD_W - 1, LCD_H - 1);
  for (uint32_t i = 0; i < RS16_ACCELERATION_MENU_V24_RLE_COUNT; i++) {
    uint16_t pixelCount = pgm_read_word(&RS16_ACCELERATION_MENU_V24_RLE[i].count);
    uint16_t color = pgm_read_word(&RS16_ACCELERATION_MENU_V24_RLE[i].color);
    const uint8_t hi = color >> 8;
    const uint8_t lo = color & 0xFF;

    for (uint16_t p = 0; p < sizeof(solidPixelBuffer); p += 2) {
      solidPixelBuffer[p] = hi;
      solidPixelBuffer[p + 1] = lo;
    }

    uint32_t bytesRemaining = (uint32_t)pixelCount * 2UL;
    while (bytesRemaining > 0) {
      uint32_t block = bytesRemaining > sizeof(solidPixelBuffer)
        ? sizeof(solidPixelBuffer) : bytesRemaining;
      lcdSPI.transferBytes(solidPixelBuffer, nullptr, block);
      bytesRemaining -= block;
    }
  }
  lcdEndWrite();
}struct ImuCalibrationMenuV24RleRun {
  uint16_t count;
  uint16_t color;
};

