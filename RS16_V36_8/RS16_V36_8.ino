  drawTextRightV31(x0-4,bTop,topB,C_V31_GRAY,1);drawTextRightV31(x0-4,bMid-3,"0",C_V31_GRAY,1);drawTextRightV31(x0-4,bBot-7,botB,C_V31_GRAY,1);
