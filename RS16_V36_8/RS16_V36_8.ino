static void drawHistRunV38(){
  const RunLogV38& r=runLogV38;char name[20],v[40];
  float finT=0;for(uint8_t i=0;i<DRAG_CP_N;i++)if(r.target[i]>finT)finT=r.target[i];
  histModeNameV39(r.mode,finT,name,sizeof(name));
  const bool spdCp=histModeIsSpeedV39(r.mode);
  histTraceV37=r.tr;   // histSpeedAtV37 membaca buffer ini
  if(histRunPageV38==0){
    // ---- DATA: hasil + setting yang dipakai saat run itu ----
    fillScreen(C_V31_BG);drawTopBarV31();
    fillRect(0,36,320,28,C_V31_BLUE);
    const SessSumV39& p=histSessCurV39();
    {char sn[14];histSessTextV39(runDatesV38[histDateSelV38],p,sn,sizeof(sn));
     snprintf(v,sizeof(v),"RUN %u",(unsigned)(histRunSelV38+1));drawTextV31(8,42,v,C_V31_WHITE,2);
     formatMsV31(r.total?r.total:0xFFFFFFFFUL,v,sizeof(v));drawTextRightV31(236,42,v,C_V31_WHITE,2);
     drawTextRightV31(314,38,sn,C_V31_WHITE,1);
     snprintf(v,sizeof(v),"%02u.%02u.%02u",r.hh,r.mm,r.ss);drawTextRightV31(314,52,v,C_V31_WHITE,1);}
    // BEST sesi + selisih run ini
    if(p.best){char bt[16];formatMsV31(p.best,bt,sizeof(bt));snprintf(v,sizeof(v),"BEST %s @RUN %u",bt,(unsigned)p.bestRun);drawTextV31(8,68,v,C_V31_GREEN,1);
      if(!r.completed)drawTextRightV31(314,68,"STOP",C_V31_RED,1);
      else if(r.total==p.best&&(uint8_t)(histRunSelV38+1)==p.bestRun)drawTextRightV31(314,68,"RUN TERBAIK",C_V31_GREEN,1);
      else if(r.total>=p.best){const uint32_t d=r.total-p.best;snprintf(v,sizeof(v),"+%lu.%03lu",(unsigned long)(d/1000UL),(unsigned long)(d%1000UL));drawTextRightV31(314,68,v,C_V31_RED,1);}}
    else drawTextV31(8,68,"BEST --  (BELUM ADA RUN FINISH)",C_V31_GRAY,1);
    int16_t y=82;
    const DragModeId keep=selectedDragMode;selectedDragMode=(DragModeId)r.mode;
