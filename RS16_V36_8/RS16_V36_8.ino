// V36.6 pemakaian flash: DATA = partisi riwayat (LittleFS), PROGRAM = firmware vs slot aplikasi
static uint8_t flashDataPctV38(uint32_t* usedKb,uint32_t* totKb){
  if(!runFsOkV38){*usedKb=*totKb=0;return 0;}
  const size_t t=LittleFS.totalBytes(),u=LittleFS.usedBytes();*usedKb=u/1024;*totKb=t/1024;
  return t?(uint8_t)min((size_t)100,(u*100+t/2)/t):0;
}
static uint8_t flashProgPctV38(){
  const uint32_t sk=ESP.getSketchSize(),fr=ESP.getFreeSketchSpace();const uint32_t slot=sk+fr;
  return slot?(uint8_t)min(100UL,((unsigned long)sk*100UL+slot/2)/slot):0;
}
static void flashDataTextV38(char* o,size_t n){
  uint32_t u,t;const uint8_t pc=flashDataPctV38(&u,&t);
  if(!runFsOkV38)snprintf(o,n,"IC FLASH: PARTISI TIDAK ADA");
  else snprintf(o,n,"IC FLASH %u%% TERPAKAI",pc);
}
// microSD: dihitung terpisah dari IC flash. Nilai di-cache 30 s (hitung ruang kosong kartu bisa lambat).
static uint64_t sdUsedV38=0,sdTotV38=0;static uint32_t sdCalcMsV38=0;static bool sdCalcOkV38=false;
static uint8_t sdPctV38(){
  if(!sdReadyV31){sdCalcOkV38=false;return 0;}
  if(!sdCalcOkV38||millis()-sdCalcMsV38>30000UL){sdTotV38=SD.totalBytes();sdUsedV38=SD.usedBytes();sdCalcMsV38=millis();sdCalcOkV38=true;}
  return sdTotV38?(uint8_t)min((uint64_t)100,(sdUsedV38*100+sdTotV38/2)/sdTotV38):0;
}
static void sdDataTextV38(char* o,size_t n){
  if(!sdReadyV31){snprintf(o,n,"MICRO SD: TIDAK ADA KARTU");return;}
  snprintf(o,n,"MICRO SD %u%% TERPAKAI",sdPctV38());
}
