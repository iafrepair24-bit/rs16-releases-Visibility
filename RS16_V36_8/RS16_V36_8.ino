static void histOpenLogV39(){
  logCntV39=0;logSelV39=0;
  if(sdReadyV31){
    File root=SD.open("/");
    if(root){File f=root.openNextFile();
      while(f){
        const char* nm=f.name();const char* b=strrchr(nm,'/');b=b?b+1:nm;
        if(!f.isDirectory()&&(!strncmp(b,"LOG_",4)||!strcmp(b,"RS16_LOG.CSV"))){
          LogSumV39 e;e.ymd=0;e.hms=0;e.kb=(uint32_t)((f.size()+1023)/1024);
          if(!strncmp(b,"LOG_",4)){uint8_t k=4;while(k<12&&b[k]>='0'&&b[k]<='9'){e.ymd=e.ymd*10+(b[k]-'0');k++;}if(b[k]=='_'){k++;uint8_t z=0;while(z<6&&b[k]>='0'&&b[k]<='9'){e.hms=e.hms*10+(b[k]-'0');k++;z++;}}}
          // sisip urut turun (terbaru dulu); kalau penuh, yang paling lama dibuang
          int16_t pos=logCntV39;
          while(pos>0&&(logSumV39[pos-1].ymd<e.ymd||(logSumV39[pos-1].ymd==e.ymd&&logSumV39[pos-1].hms<e.hms)))pos--;
          if(pos<HIST_LOG_N_V39){const int16_t last=(logCntV39<HIST_LOG_N_V39)?logCntV39:HIST_LOG_N_V39-1;for(int16_t m=last;m>pos;m--)logSumV39[m]=logSumV39[m-1];logSumV39[pos]=e;if(logCntV39<HIST_LOG_N_V39)logCntV39++;}
        }
        f.close();f=root.openNextFile();
      }
      root.close();}
  }
  uiTestScreen=UI_HIST_LOG_V39;screenDirtyV31=true;
}
