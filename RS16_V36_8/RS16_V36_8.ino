    uint16_t k=0;for(uint16_t i=0;i<trackPathCountV36;i+=2){trackPathXV36[k]=trackPathXV36[i];trackPathYV36[k]=trackPathYV36[i];k++;}
    trackPathCountV36=k;trackPathMinStepV36*=2.0f;
  }
