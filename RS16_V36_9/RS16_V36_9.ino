    drawTextRightV31(x0-4,bTop,"KA",C_V31_GRAY,1);drawTextRightV31(x0-4,bMid-3,"0",C_V31_GRAY,1);drawTextRightV31(x0-4,bBot-7,"KI",C_V31_GRAY,1);
