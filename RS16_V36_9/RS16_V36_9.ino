  if(!dragRtV31.motionSeen){
    if(sp<1.0f){dragRtV31.prevTow=tow;dragRtV31.prevSpeedKmh=sp;dragRtV31.prevPosValid=true;return;}
    // 13 Nov 2026: run otomatis hanya mulai dari kondisi DIAM (armed ulang setelah finish/stop
    // bisa terjadi saat kendaraan masih jalan -> tunggu berhenti dulu, jangan start dari tengah jalan).
