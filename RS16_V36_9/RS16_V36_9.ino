// grafik 2 jalur generik (dipakai G-FORCE & ATTITUDE)
static void drawTwinStripV38(const char* title,const char* name,const int8_t* a,const int8_t* b,float scaleA,float scaleB,float limA,float limB,
                             const char* labA,const char* labB,const char* topA,const char* botA,const char* topB,const char* botB,const char* unit,const char* footer){
  const HistTraceV37& h=runLogV38.tr;char v[40];
  fillScreen(C_V31_BG);drawTopBarV31();
  drawTextV31(14,38,title,C_V31_WHITE,2);drawTextRightV31(306,42,name,C_V31_BLUE,1);
  if(h.n<2){drawTextCenteredV31(160,112,"DATA TIDAK TERSIMPAN",C_V31_GRAY,1);drawTextRightV31(306,229,footer,C_V31_GRAY,1);return;}
  const int16_t x0=40,x1=306,w=x1-x0;
  uint32_t tmax=(uint32_t)h.t10[h.n-1]*10UL;if(runLogV38.total>tmax)tmax=runLogV38.total;if(tmax<100)tmax=100;
  float pa=0,pb=0,qa=0,qb=0;
  for(uint16_t i=0;i<h.n;i++){const float x=a[i]/scaleA,y=b[i]/scaleB;if(x>pa)pa=x;if(-x>pb)pb=-x;if(y>qa)qa=y;if(-y>qb)qb=-y;}
  auto gx=[&](uint16_t i)->int16_t{return x0+(int16_t)((float)h.t10[i]*10.0f/tmax*w);};
  const int16_t aTop=62,aBot=128,bTop=146,bBot=200,aMid=(aTop+aBot)/2,bMid=(bTop+bBot)/2;
  drawRectV31(x0,aTop,w,aBot-aTop+1,C_V31_EDGE);drawHLineV31(x0,aMid,w,C_V31_GRAY);
