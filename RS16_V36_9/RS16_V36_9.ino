static uint8_t daysInMonthV38(uint16_t y,uint8_t m){static const uint8_t d[12]={31,28,31,30,31,30,31,31,30,31,30,31};if(m<1||m>12)return 31;return (m==2&&((y%4==0&&y%100!=0)||y%400==0))?29:d[m-1];}
// tanggal & jam lokal (WIB) dari waktu GPS. false kalau GPS belum punya tanggal valid.
static bool localNowV38(uint32_t* ymd,uint8_t* hh,uint8_t* mi,uint8_t* ss){
  if(!gpsDateTimeValidV30||gpsYearV30<2020)return false;
  uint16_t y=gpsYearV30;uint8_t mo=gpsMonthV30,d=gpsDayV30;
  int32_t mins=(int32_t)gpsHourV30*60+gpsMinuteV30+RS16_TZ_OFFSET_MIN;
  while(mins>=1440){mins-=1440;if(++d>daysInMonthV38(y,mo)){d=1;if(++mo>12){mo=1;y++;}}}
  while(mins<0){mins+=1440;if(--d<1){if(--mo<1){mo=12;y--;}d=daysInMonthV38(y,mo);}}
  *ymd=(uint32_t)y*10000UL+mo*100UL+d;*hh=(uint8_t)(mins/60);*mi=(uint8_t)(mins%60);*ss=gpsSecondV30;return true;
}
