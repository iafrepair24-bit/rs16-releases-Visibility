    return;
  }
  if(histRunPageV38==3){
    drawTwinStripV38("G-FORCE",name,r.tr.g,r.tr.gl,50.0f,50.0f,1.0f,1.0f,"G LONG","G LAT","+1G","-1G","KA","KI","G","RIGHT = ATTITUDE");
