// ======================= V36.9 WEBSOCKET UNTUK APLIKASI (port 81) =======================
// Protokol aplikasi RS16 Race Speed: alat -> HP teks per baris ("HELLO,RS16,36.9" lalu "RS,..." tiap sampel GPS);
// HP -> alat teks per baris (mis. "HZ,25"). Server minimal (RFC 6455), maks 3 HP, tanpa library tambahan.
#define WS_MAX_CLI_V41 3
struct WsCliV41{WiFiClient c;bool open;char hs[600];uint16_t hsLen;uint8_t rx[260];uint16_t rxLen;uint32_t t0;};
static WiFiServer wsServerV41(81);
static WsCliV41 wsCliV41[WS_MAX_CLI_V41];
static bool wsRunningV41=false;
static float wsGLatV41(){return imuConnectedV31?gLatV31:0.0f;}
static float wsGLongV41(){return imuConnectedV31?gLongV31:0.0f;}
static void wsDropV41(WsCliV41& k){if(k.c)k.c.stop();if(k.open&&wsOpenCountV41)wsOpenCountV41--;k.open=false;k.hsLen=0;k.rxLen=0;}
static bool wsSendFrameV41(WsCliV41& k,uint8_t op,const uint8_t* d,size_t n){
  uint8_t h[4];size_t hl;
  h[0]=(uint8_t)(0x80|op);
  if(n<126){h[1]=(uint8_t)n;hl=2;}else{h[1]=126;h[2]=(uint8_t)(n>>8);h[3]=(uint8_t)(n&0xFF);hl=4;}
  if(k.c.write(h,hl)!=hl)return false;
  return n==0||k.c.write(d,n)==n;
}
static void wsCommandV41(const char* l){
  // perintah dari aplikasi. "HZ,.." diabaikan: rate GPS dikunci & otomatis mengikuti GNSS SYSTEM (lihat CLAUDE.md).
  Serial.printf("APP> %s%s\n",l,strncmp(l,"HZ,",3)==0?"  (diabaikan: rate GPS otomatis)":"");
}
static void wsHandshakeV41(WsCliV41& k){
  char* key=nullptr;
  for(char* q=k.hs;*q;q++){if(strncasecmp(q,"Sec-WebSocket-Key:",18)==0){key=q+18;break;}}
  if(!key){k.c.print("HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n");wsDropV41(k);return;}
  while(*key==' ')key++;
  char kk[80];uint8_t n=0;while(key[n]&&key[n]!='\r'&&key[n]!='\n'&&n<60){kk[n]=key[n];n++;}kk[n]=0;
  strcat(kk,"258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
  uint8_t sha[20];
#if MBEDTLS_VERSION_NUMBER >= 0x03000000
  mbedtls_sha1((const unsigned char*)kk,strlen(kk),sha);
#else
  mbedtls_sha1_ret((const unsigned char*)kk,strlen(kk),sha);
#endif
  unsigned char acc[40];size_t ol=0;mbedtls_base64_encode(acc,sizeof(acc),&ol,sha,20);acc[ol]=0;
  char r[200];snprintf(r,sizeof(r),"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: %s\r\n\r\n",(const char*)acc);
  k.c.print(r);k.c.setNoDelay(true);k.open=true;k.rxLen=0;wsOpenCountV41++;
  char hello[40];snprintf(hello,sizeof(hello),"HELLO,RS16,%s\n",RS16_FW_VERSION_NUM);
  wsSendFrameV41(k,0x1,(const uint8_t*)hello,strlen(hello));
  Serial.printf("APP: HP tersambung (WebSocket), total %u\n",(unsigned)wsOpenCountV41);screenDirtyV31=true;
}
static void wsReadV41(WsCliV41& k){
  while(k.c.available()&&k.rxLen<sizeof(k.rx))k.rx[k.rxLen++]=(uint8_t)k.c.read();
  for(;;){
    if(k.rxLen<2)return;
    const uint8_t op=k.rx[0]&0x0F;const bool masked=k.rx[1]&0x80;size_t n=k.rx[1]&0x7F,hl=2;
    if(n==126){if(k.rxLen<4)return;n=((size_t)k.rx[2]<<8)|k.rx[3];hl=4;}else if(n==127){wsDropV41(k);return;}
    if(masked)hl+=4;
    if(n>200||hl+n>sizeof(k.rx)){wsDropV41(k);return;}   // aplikasi hanya mengirim perintah pendek
    if(k.rxLen<hl+n)return;
    uint8_t* d=&k.rx[hl];
    if(masked){const uint8_t* m=&k.rx[hl-4];for(size_t i=0;i<n;i++)d[i]^=m[i&3];}
    if(op==0x8){wsSendFrameV41(k,0x8,nullptr,0);wsDropV41(k);Serial.println("APP: HP memutus WebSocket");screenDirtyV31=true;return;}
    if(op==0x9)wsSendFrameV41(k,0xA,d,n);
    if(op==0x1&&n){char l[201];memcpy(l,d,n);l[n]=0;char* e=l+strlen(l);while(e>l&&(e[-1]=='\n'||e[-1]=='\r'))*--e=0;if(*l)wsCommandV41(l);}
    const size_t used=hl+n;memmove(k.rx,k.rx+used,k.rxLen-used);k.rxLen-=used;
  }
}
static void serviceWsV41(){
  if(!wsRunningV41)return;
  {WiFiClient nc=wsServerV41.accept();
   if(nc){bool placed=false;for(uint8_t i=0;i<WS_MAX_CLI_V41&&!placed;i++){WsCliV41& k=wsCliV41[i];if(!k.c||!k.c.connected()){wsDropV41(k);k.c=nc;k.hsLen=0;k.hs[0]=0;k.t0=millis();placed=true;}}
     if(!placed)nc.stop();}}
  for(uint8_t i=0;i<WS_MAX_CLI_V41;i++){
    WsCliV41& k=wsCliV41[i];if(!k.c)continue;
    if(!k.c.connected()){if(k.open)Serial.println("APP: HP terputus");wsDropV41(k);screenDirtyV31=true;continue;}
    if(!k.open){
      while(k.c.available()&&k.hsLen<sizeof(k.hs)-1){k.hs[k.hsLen++]=(char)k.c.read();k.hs[k.hsLen]=0;}
      if(strstr(k.hs,"\r\n\r\n"))wsHandshakeV41(k);
      else if(k.hsLen>=sizeof(k.hs)-1||millis()-k.t0>3000UL)wsDropV41(k);
      continue;
    }
    wsReadV41(k);
  }
  // kirim semua baris yang antre dalam satu frame per HP
  if(wsQHeadV41==wsQTailV41)return;
  static char out[WS_Q_N_V41*100];size_t o=0;
  while(wsQTailV41!=wsQHeadV41&&o<sizeof(out)-100){const size_t m=strlen(wsQV41[wsQTailV41]);memcpy(out+o,wsQV41[wsQTailV41],m);o+=m;out[o++]='\n';wsQTailV41=(uint8_t)((wsQTailV41+1)%WS_Q_N_V41);}
  for(uint8_t i=0;i<WS_MAX_CLI_V41;i++){WsCliV41& k=wsCliV41[i];if(k.open&&!wsSendFrameV41(k,0x1,(const uint8_t*)out,o)){Serial.println("APP: kirim gagal, HP diputus");wsDropV41(k);}}
}
static void wsStartV41(){if(wsRunningV41)return;wsServerV41.begin();wsServerV41.setNoDelay(true);wsRunningV41=true;}
static void wsStopV41(){if(!wsRunningV41)return;for(uint8_t i=0;i<WS_MAX_CLI_V41;i++)wsDropV41(wsCliV41[i]);wsServerV41.end();wsRunningV41=false;wsOpenCountV41=0;wsQHeadV41=wsQTailV41=0;}
