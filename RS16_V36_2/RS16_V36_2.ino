  drawPanelV31(14,111,72,36,false);drawPanelV31(92,111,72,36,false);drawPanelV31(170,111,72,36,false);
  drawTextCenteredV31(50,118,"BEST",C_V31_GRAY,1);drawTextCenteredV31(128,118,"LAST",C_V31_GRAY,1);drawTextCenteredV31(206,118,"S2",C_V31_GRAY,1);
  drawTextCenteredV31(50,134,best,C_V31_WHITE,1);drawTextCenteredV31(128,134,last,C_V31_WHITE,1);
  char sec[20];formatMsV31(circuitRtV31.sectorIndex?circuitRtV31.sectorMs[circuitRtV31.sectorIndex-1]:0xFFFFFFFFUL,sec,sizeof(sec));
  drawTextCenteredV31(206,134,sec,circuitRtV31.sectorIndex?C_V31_BLUE:C_V31_WHITE,1);

  // Track path zone – live source, no fake route.
  // V36.2 TRACK PATH nyata (dulu kotak kosong): jalur dari trackPathXV36/YV36 diskalakan ke kotak.
  {
    const int16_t bx=252,by=104,bw=56,bh=56;
    drawRectV31(bx,by,bw,bh,C_V31_EDGE);
    if(trackPathCountV36>=2){
      int16_t mnx=trackPathXV36[0],mxx=mnx,mny=trackPathYV36[0],mxy=mny;
      for(uint16_t i=1;i<trackPathCountV36;i++){mnx=min(mnx,trackPathXV36[i]);mxx=max(mxx,trackPathXV36[i]);mny=min(mny,trackPathYV36[i]);mxy=max(mxy,trackPathYV36[i]);}
      const float rx=(float)max((int16_t)1,(int16_t)(mxx-mnx)),ry=(float)max((int16_t)1,(int16_t)(mxy-mny));
      const float sc=min((bw-6)/rx,(bh-6)/ry);
      const int16_t ox=bx+3+(int16_t)(((bw-6)-rx*sc)/2),oy=by+3+(int16_t)(((bh-6)-ry*sc)/2);
      auto PX=[&](uint16_t i)->int16_t{return ox+(int16_t)((trackPathXV36[i]-mnx)*sc);};
      auto PY=[&](uint16_t i)->int16_t{return oy+(int16_t)((mxy-trackPathYV36[i])*sc);};   // utara = atas
      for(uint16_t i=1;i<trackPathCountV36;i++)drawLineV31(PX(i-1),PY(i-1),PX(i),PY(i),C_V31_TEXT);
      fillRect(PX(0)-1,PY(0)-1,3,3,C_V31_BLUE);                                  // garis start
      fillRect(PX(trackPathCountV36-1)-1,PY(trackPathCountV36-1)-1,3,3,C_V31_WHITE); // posisi terakhir
    }else drawTextCenteredV31(bx+bw/2,by+bh/2-3,"--",C_V31_DARK,1);
  }
  drawTextV31(14,228,"TRACK PATH",C_V31_GRAY,1);
  drawTextRightV31(302,228,circuitAutoLapV31?"AUTO LAP ON":"AUTO LAP OFF",circuitAutoLapV31?C_V31_BLUE:C_V31_GRAY,1);
}
