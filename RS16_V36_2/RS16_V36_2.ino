  if(telemetryHavePrevV31){float step=gpsDistanceMetersV30(telemetryPrevLatV31,telemetryPrevLonV31,gpsLatitudeV30,gpsLongitudeV30);if(step>=0&&step<15)telemetryDistanceV31+=step;uint32_t dt=gpsTowDeltaMsV30(gpsITowMsV30,telemetryPrevTowV31);if(dt>0&&dt<500)acc=((gpsSpeedKmhV30/3.6f)-telemetryPrevSpeedMpsV31)/(dt*0.001f);}
