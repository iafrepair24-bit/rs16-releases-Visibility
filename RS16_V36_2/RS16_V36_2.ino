int8_t fontIndexV31(char ch){
  if(ch>='a'&&ch<='z')ch-=32; const uint8_t n=(uint8_t)(sizeof(FONT_MAP_V31)-1);
  for(uint8_t i=0;i<n;i++) if(pgm_read_byte(&FONT_MAP_V31[i])==ch)return i; return 0;
}
int16_t textWidthV31(const char* s,uint8_t scale=1){ if(!s||!*s)return 0; return (int16_t)(strlen(s)*6*scale-scale); }
void drawGlyphV31(int16_t x,int16_t y,char ch,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  int8_t idx=fontIndexV31(ch); if(opaque)fillRect(x,y,6*scale,8*scale,bg);
  for(uint8_t r=0;r<7;r++){ uint8_t bits=pgm_read_byte(&FONT_ROWS_V31[idx][r]);
    for(uint8_t col=0;col<5;col++) if(bits&(1<<(4-col))) fillRect(x+col*scale,y+r*scale,scale,scale,fg); }
}
void drawTextV31(int16_t x,int16_t y,const char* s,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  if(!s)return; while(*s){drawGlyphV31(x,y,*s,fg,scale,bg,opaque);x+=6*scale;s++;}
}
void drawTextCenteredV31(int16_t cx,int16_t y,const char* s,uint16_t fg,uint8_t scale=1,uint16_t bg=C_V31_BG,bool opaque=false){
  drawTextV31(cx-textWidthV31(s,scale)/2,y,s,fg,scale,bg,opaque);
}
void drawTextRightV31(int16_t xr,int16_t y,const char* s,uint16_t fg,uint8_t scale=1){ drawTextV31(xr-textWidthV31(s,scale),y,s,fg,scale); }
void drawTextBoldV31(int16_t x,int16_t y,const char* s,uint16_t fg,uint8_t scale=1){drawTextV31(x,y,s,fg,scale);drawTextV31(x+1,y,s,fg,scale);}
void drawPanelV31(int16_t x,int16_t y,int16_t w,int16_t h,bool selected=false){
  fillRect(x,y,w,h,C_V31_PANEL); drawRectV31(x,y,w,h,selected?C_V31_BLUE:C_V31_EDGE);
  if(selected) drawRectV31(x+1,y+1,w-2,h-2,C_V31_BLUE_DIM);
}

// ---------- V36.1 gaya seleksi global: kotak abu-abu, sudut membulat, tepi halus ----------
void drawRoundSelectV36(int16_t x,int16_t y,int16_t w,int16_t h,int16_t r=10,uint16_t col=C_V31_GRAY){
  if(w<6||h<6)return;
  int16_t maxR=(w<h?w:h)/2; if(r>maxR)r=maxR; if(r<2)r=2;
  const float T=2.4f, rc=(float)r-T*0.5f;
  const uint8_t cr=(uint8_t)((col>>11)&0x1F), cg=(uint8_t)((col>>5)&0x3F), cb=(uint8_t)(col&0x1F);
  // sisi lurus
  fillRect(x+r,y,w-2*r,2,col);
  fillRect(x+r,y+h-2,w-2*r,2,col);
  fillRect(x,y+r,2,h-2*r,col);
  fillRect(x+w-2,y+r,2,h-2*r,col);
  // sudut membulat dengan tepi dihaluskan
  for(uint8_t c=0;c<4;c++){
    const int16_t ox=(c&1)?(x+w-r):x;
    const int16_t oy=(c&2)?(y+h-r):y;
    const float cx=(c&1)?(float)(x+w-r):(float)(x+r);
    const float cy=(c&2)?(float)(y+h-r):(float)(y+r);
    for(int16_t py=0;py<r;py++){
      for(int16_t px=0;px<r;px++){
        const float dx=(float)(ox+px)+0.5f-cx;
        const float dy=(float)(oy+py)+0.5f-cy;
        const float d=sqrtf(dx*dx+dy*dy);
        float a=1.0f-(fabsf(d-rc)-(T*0.5f-0.5f));
        if(a<=0.05f)continue; if(a>1.0f)a=1.0f;
        const uint16_t cc=(uint16_t)(((uint16_t)(cr*a+0.5f)<<11)|((uint16_t)(cg*a+0.5f)<<5)|(uint16_t)(cb*a+0.5f));
        if(cc)fillRect(ox+px,oy+py,1,1,cc);
      }
    }
  }
}

// Tabel penghapus panel/kotak bawaan pada bitmap layar menu (bitmap aslinya tidak diubah).
struct ScreenEraseRun { uint8_t y; uint16_t x; uint16_t len; } __attribute__((packed));
static void drawScreenEraseV36(const ScreenEraseRun* runs,uint16_t n){
  for(uint16_t i=0;i<n;i++){
    const uint8_t y=pgm_read_byte(&runs[i].y);
    const uint16_t x=pgm_read_word(&runs[i].x);
    const uint16_t len=pgm_read_word(&runs[i].len);
    fillRect((int16_t)x,(int16_t)y,(int16_t)len,1,C_V31_BG);
  }
}
