void drawPixelV31(int16_t x, int16_t y, uint16_t c) {
  if (x < 0 || y < 0 || x >= LCD_W || y >= LCD_H) return;
  fillRect(x,y,1,1,c);
}
void drawHLineV31(int16_t x, int16_t y, int16_t w, uint16_t c) { fillRect(x,y,w,1,c); }
void drawVLineV31(int16_t x, int16_t y, int16_t h, uint16_t c) { fillRect(x,y,1,h,c); }
void drawRectV31(int16_t x,int16_t y,int16_t w,int16_t h,uint16_t c) {
  if(w<2||h<2)return; drawHLineV31(x,y,w,c); drawHLineV31(x,y+h-1,w,c);
  drawVLineV31(x,y,h,c); drawVLineV31(x+w-1,y,h,c);
}
void drawLineV31(int16_t x0,int16_t y0,int16_t x1,int16_t y1,uint16_t c) {
  int16_t dx=abs(x1-x0), sx=x0<x1?1:-1, dy=-abs(y1-y0), sy=y0<y1?1:-1, e=dx+dy;
  while(true){ drawPixelV31(x0,y0,c); if(x0==x1&&y0==y1)break; int16_t e2=e*2;
    if(e2>=dy){e+=dy;x0+=sx;} if(e2<=dx){e+=dx;y0+=sy;} }
}

