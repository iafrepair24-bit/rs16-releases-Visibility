// ---------- V36.2 helper gambar ----------
// Cincin/lingkaran penuh tanpa celah: diisi per baris (ri=0 -> lingkaran penuh).
static void drawRingV36(int16_t cx,int16_t cy,int16_t ro,int16_t ri,uint16_t c){
  for(int16_t dy=-ro;dy<=ro;dy++){
    const int16_t xo=(int16_t)sqrtf((float)((int32_t)ro*ro-(int32_t)dy*dy));
    if(ri>0&&abs(dy)<ri){
      const int16_t xi=(int16_t)sqrtf((float)((int32_t)ri*ri-(int32_t)dy*dy));
      if(xo>xi){fillRect(cx-xo,cy+dy,xo-xi,1,c);fillRect(cx+xi+1,cy+dy,xo-xi,1,c);}
    }else fillRect(cx-xo,cy+dy,2*xo+1,1,c);
  }
}
// Daftar ala Qstarz LT-8000 (warna RS16): baris besar, kotak seleksi RS16, titik biru = pilihan aktif.
static void drawListV36(const char* const* labels,const char* const* values,uint8_t n,uint8_t sel,int8_t active,const char* hint){
  fillScreen(C_V31_BG);drawTopBarV31();
  const int16_t y0=40,rowH=34;
  for(uint8_t i=0;i<n;i++){
    const int16_t y=y0+i*rowH;
    if(i==sel)drawRoundSelectV36(8,y,304,30,9);
    int16_t tx=22;
    if(active>=0){ if(i==(uint8_t)active)drawRingV36(26,y+15,4,0,C_V31_BLUE); tx=40; }
    drawTextV31(tx,y+8,labels[i],i==sel?C_V31_WHITE:C_V31_TEXT,2);
    if(values&&values[i]&&values[i][0])drawTextRightV31(302,y+11,values[i],i==sel?C_V31_BLUE:C_V31_GRAY,1);
  }
  if(hint)drawTextCenteredV31(160,228,hint,C_V31_GRAY,1);
}

// ---------- V36.2 GNSS STATUS ala Qstarz: bar C/N0 per satelit ----------
// Angka di atas bar = C/N0 (dB-Hz), angka di bawah = PRN/SV ID. Maks 12 sinyal terkuat,
// diurutkan menurut PRN. BIRU = dipakai solusi posisi, PUTIH = terlacak tapi belum dipakai.
static void drawGpsSatelliteV31(){
  fillScreen(C_V31_BG);drawTopBarV31();
  const uint32_t now=millis();
  const bool uartAlive=(gpsLastByteMillisV32!=0 && now-gpsLastByteMillisV32<3000UL);
  const bool pvtAlive=(gpsLastPvtMillisV30!=0 && now-gpsLastPvtMillisV30<1500UL);

  const char* status;uint16_t statusColor;
  if(gpsReadyLatchedV35){status="3D FIX";statusColor=C_V31_GREEN;}
  else if(!uartAlive){status="NO GPS DATA";statusColor=C_V31_RED;}
  else if(!pvtAlive){status="CONFIG";statusColor=C_V31_BLUE;}
  else if(gpsFixTypeV30==2){status="2D FIX";statusColor=C_V31_BLUE;}
  else{status="SEARCHING";statusColor=C_V31_BLUE;}
  drawTextV31(14,38,status,statusColor,1);
  char v[32];
  if(gpsHdopValidV30)snprintf(v,sizeof(v),"USED %u/%u  HDOP %.1f",(unsigned)gpsSatUsedV31,(unsigned)gpsSatViewCountV32,gpsHdopV30);
  else snprintf(v,sizeof(v),"USED %u/%u",(unsigned)gpsSatUsedV31,(unsigned)gpsSatViewCountV32);
  drawTextRightV31(306,38,v,C_V31_TEXT,1);

  // pilih 12 sinyal terkuat, lalu urutkan menurut PRN
  uint8_t idx[GPS_SAT_VIEW_MAX_V32];
  uint8_t n=gpsSatViewCountV32;if(n>GPS_SAT_VIEW_MAX_V32)n=GPS_SAT_VIEW_MAX_V32;
  for(uint8_t i=0;i<n;i++)idx[i]=i;
  for(uint8_t i=1;i<n;i++){uint8_t k=idx[i];int8_t j=i-1;while(j>=0&&gpsSatViewCnoV32[idx[j]]<gpsSatViewCnoV32[k]){idx[j+1]=idx[j];j--;}idx[j+1]=k;}
  if(n>12)n=12;
  for(uint8_t i=1;i<n;i++){uint8_t k=idx[i];int8_t j=i-1;
    while(j>=0&&((uint16_t)gpsSatViewIdV32[idx[j]]*8+gpsSatViewGnssV32[idx[j]])>((uint16_t)gpsSatViewIdV32[k]*8+gpsSatViewGnssV32[k])){idx[j+1]=idx[j];j--;}idx[j+1]=k;}

  const int16_t barBase=198,maxH=116,barW=18,step=24;
  const int16_t x0=160-(int16_t)(n*step-(step-barW))/2;
  for(uint8_t i=0;i<n;i++){
    const uint8_t s=idx[i];const uint8_t cno=gpsSatViewCnoV32[s];
    int16_t h=(int16_t)((uint16_t)cno*maxH/50U);if(h<3)h=3;if(h>maxH)h=maxH;
    const int16_t bx=x0+i*step;
    fillRect(bx,barBase-h,barW,h,gpsSatViewUsedV32[s]?C_V31_BLUE:C_V31_WHITE);
    snprintf(v,sizeof(v),"%u",(unsigned)cno);drawTextCenteredV31(bx+barW/2,barBase-h-10,v,C_V31_WHITE,1);
    snprintf(v,sizeof(v),"%02u",(unsigned)gpsSatViewIdV32[s]);drawTextCenteredV31(bx+barW/2,barBase+5,v,C_V31_WHITE,1);
  }
  if(n==0){
    drawTextCenteredV31(160,110,uartAlive?"MENCARI SINYAL...":"CHECK GPS UART",uartAlive?C_V31_TEXT:C_V31_RED,2);
    drawTextCenteredV31(160,136,uartAlive?"BAWA KE AREA TERBUKA":"TIDAK ADA DATA DARI MODUL GPS",C_V31_GRAY,1);
  }

  if(pvtAlive && gpsFixTypeV30>=2)snprintf(v,sizeof(v),"%.5f %.5f",gpsLatitudeV30,gpsLongitudeV30);
  else snprintf(v,sizeof(v),"UART %lu",(unsigned long)gpsActiveBaudV32);
  drawTextV31(14,226,v,C_V31_GRAY,1);
  snprintf(v,sizeof(v),"%.1f/%u HZ",gpsActualRateHzV30,(unsigned)gnssRateHzV36());
  drawTextRightV31(306,226,v,gpsActualRateHzV30>=gnssRateHzV36()*0.8f?C_V31_BLUE:C_V31_GRAY,1);
}
