static uint8_t dragReadyLastReasonV33=255;
static uint32_t dragReadyLastRefreshV33=0;

static void serviceDragReadyUiV33(){
  if(uiTestScreen!=UI_DRAG_READY)return;
  const uint32_t now=millis();
  if(now-dragReadyLastRefreshV33<350UL)return;
  dragReadyLastRefreshV33=now;

  uint8_t reason=gpsTimingReasonV33();
  if(reason!=dragReadyLastReasonV33){
    dragReadyLastReasonV33=reason;
    drawDragStandbyV31();
  }else{
    // Only refresh top status values; do not redraw the whole standby screen.
    drawTopBarStatusOnlyV32();
  }
}

static uint32_t lastTopBarOnlyMsV31=0;
static void serviceTopBarOnlyV31(){
  if(periodicUiV31()) return;
  const uint32_t now=millis();
  if(now-lastTopBarOnlyMsV31<1000UL) return;
  lastTopBarOnlyMsV31=now;
  if(fbV36&&uiFbScreenV36()){screenDirtyV31=true;return;}   // V36.2: jam/baterai ikut lewat framebuffer
  drawTopBarStatusOnlyV32();
}

static bool activeMeasurementV31(){return uiTestScreen==UI_DRAG_RUNNING||uiTestScreen==UI_CIRCUIT_RUNNING||uiTestScreen==UI_GPS_LOGGER_RECORDING||otaInProgressV31;}
static void serviceAutoShutdownV31(){uint8_t mins=AUTO_SHUTDOWN_MINUTES_V31[autoShutdownIndexV31];if(!mins||activeMeasurementV31()||displaySleepingV31)return;bool moving=gpsSpeedKmhV30>1.0f||fabsf(gLongV31)>0.12f||fabsf(gLatV31)>0.12f;if(moving){lastActivityMsV31=millis();return;}if(millis()-lastActivityMsV31>mins*60000UL){powerOffV36("AUTO SHUTDOWN");}}
// FIX 6 Sep 2026: dulu gpsSpeedKmhV30 tidak pernah di-nol-kan saat sinyal GPS hilang, jadi layar
// (Circuit / GPS Logger / speedometer) tetap menampilkan angka kecepatan terakhir seolah masih live
// padahal PVT sudah berhenti -- menyesatkan saat masuk terowongan atau kehilangan fix.
// Aman untuk engine pengukuran: serviceDragV31()/serviceCircuitV31()/serviceLoggerV31() hanya
// bekerja saat ada paket PVT BARU (dijaga pembanding nomor urut), jadi nilai nol ini tidak akan
// pernah ikut terhitung sebagai data race.
static void serviceGpsStaleSpeedV36(){
  if(gpsLastPvtMillisV30==0)return;
  if(millis()-gpsLastPvtMillisV30>1500UL && gpsSpeedKmhV30!=0.0f){gpsSpeedKmhV30=0.0f;screenDirtyV31=true;}
}

static void serviceGpsRecoveryV32(){
  if(activeMeasurementV31())return;
  const uint32_t now=millis();
  const bool noPvt=(gpsLastPvtMillisV30==0 || now-gpsLastPvtMillisV30>6000UL);
  const bool noBytes=(gpsLastByteMillisV32==0 || now-gpsLastByteMillisV32>5000UL);

  if(noBytes){
    if(now-gpsLastAutoDetectMillisV32>15000UL){
      gpsLastAutoDetectMillisV32=now;
      Serial.println("GNSS UART LOST - background scan disabled");
    }
    return;
  }

  if(noPvt && now-gpsLastAutoDetectMillisV32>10000UL){
    gpsLastAutoDetectMillisV32=now;
    configureGnssRateMsgsV36();
    Serial.println("GNSS PVT RECOVERY - rate config resent");
  }
}

static void serviceSerialCommandsV31(){static String cmd;while(Serial.available()){char c=Serial.read();if(c=='\n'||c=='\r'){cmd.trim();if(cmd=="status")Serial.printf("V32 GPS=%.1fHz SAT=%u USED=%u FIX=%u RX=%lu PVT=%lu ERR=%lu BAUD=%lu HACC=%.2f SACC=%.2f IMU=%s BAT=%.2f SD=%s\n",gpsActualRateHzV30,(unsigned)(gpsSatellitesV30?gpsSatellitesV30:gpsSatViewCountV32),(unsigned)gpsSatUsedV31,(unsigned)gpsFixTypeV30,(unsigned long)gpsBytesRxV30,(unsigned long)gpsPvtPacketsV30,(unsigned long)gpsChecksumErrorsV30,(unsigned long)gpsActiveBaudV32,gpsHorizontalAccuracyM_V30,gpsSpeedAccuracyKmhV30,imuConnectedV31?"OK":"NO",batteryVoltageV31,sdReadyV31?"OK":"NO");else if(cmd=="gnss 25hz")configureMg90225HzV30();else if(cmd=="imu zero")startImuCalV31(2);else if(cmd=="wifi on")startWifiV31();else if(cmd=="wifi off")stopWifiV31();cmd="";}else if(cmd.length()<64)cmd+=c;}}

// PENANDA BOOT (ditambahkan 6 Sep 2026) -- setiap langkah setup() mencetak satu baris ke Serial.
// Tujuannya: kalau board macet/reset saat boot, baris terakhir yang muncul langsung menunjukkan
// langkah mana yang jadi biang keroknya. Tidak ada kaitan dengan tampilan/LCD.
#define BOOTMARK_V36(step) do{ Serial.print("BOOT> "); Serial.println(step); Serial.flush(); }while(0)

void setup(){
  // V36.2: latch daya DIKUNCI PALING AWAL. Dulu baru setelah Serial + delay(400) -> tombol power
  // harus ditahan >0,4 s atau board mati lagi.
  pinMode(POWER_HOLD_PIN,OUTPUT);digitalWrite(POWER_HOLD_PIN,HIGH);
  Serial.begin(115200);delay(400);
  Serial.println();
  BOOTMARK_V36("00 serial hidup");
  Serial.printf("BOOT> reset reason=%d  cpu=%d MHz  heap=%u\n",
                (int)esp_reset_reason(),(int)getCpuFrequencyMhz(),(unsigned)ESP.getFreeHeap());
  Serial.flush();
  pinMode(TFT_CS,OUTPUT);pinMode(TFT_DC,OUTPUT);pinMode(TFT_RST,OUTPUT);digitalWrite(TFT_CS,HIGH);digitalWrite(TFT_DC,HIGH);digitalWrite(TFT_RST,HIGH);
  BOOTMARK_V36("01 pin TFT siap");
  pinMode(ICM_CS_PIN,OUTPUT);digitalWrite(ICM_CS_PIN,HIGH);   // IMU ICM-42688-P share bus SPI dengan TFT, CS sendiri
  pinMode(FLASH_CS_PIN,OUTPUT);digitalWrite(FLASH_CS_PIN,HIGH); // flash U7 dijamin non-aktif -- jangan sampai ikut mendorong SPI_MISO
  BOOTMARK_V36("02 pin CS IMU + flash siap");
  pinMode(POWER_HOLD_PIN,OUTPUT);digitalWrite(POWER_HOLD_PIN,HIGH); // latch daya -- wajib HIGH sesaat setelah boot (lihat Q3, audit-net-ic-pcb-produksi.md)
  BOOTMARK_V36("03 POWER_HOLD (GPIO12) HIGH");
  lcdSPI.begin(TFT_SCLK,TFT_MISO,TFT_MOSI,TFT_CS);   // bus SPI dinyalakan duluan -- dipakai IMU di initImuV31() di bawah
  BOOTMARK_V36("04 SPI hidup");
  fbV36=(uint8_t*)heap_caps_malloc((size_t)LCD_W*LCD_H,MALLOC_CAP_8BIT);
  Serial.printf("BOOT> 04b framebuffer %s (heap %u)\n",fbV36?"OK":"GAGAL -> gambar langsung",(unsigned)ESP.getFreeHeap());
  Wire.begin(MPU_SDA_PIN_V31,MPU_SCL_PIN_V31,100000);  // V36.2: PCF8574/PCF8574A maks 100 kHz (dulu 400 kHz, di luar spek)  // I2C sekarang cuma untuk PCF8574 (tombol)
  BOOTMARK_V36("05 I2C hidup");
  Wire.beginTransmission(PCF8574_ADDR_V36);Wire.write(0xFF);uint8_t pcfErr=Wire.endTransmission(); // set semua pin PCF8574 sbg input
  Serial.printf("BOOT> 06 PCF8574 0x%02X -> %s (kode %u)\n",PCF8574_ADDR_V36,pcfErr==0?"TERDETEKSI":"TIDAK MENJAWAB",(unsigned)pcfErr);
  Serial.flush();
  pinMode(BUZZER_PIN_V31,OUTPUT);digitalWrite(BUZZER_PIN_V31,LOW);
  pinMode(BATTERY_ADC_PIN_V31,INPUT);analogReadResolution(12);analogSetPinAttenuation(BATTERY_ADC_PIN_V31,ADC_11db);
  BOOTMARK_V36("07 buzzer + ADC baterai siap");
  for(uint8_t i=0;i<BUTTON_COUNT;i++){bool s=(pcf8574ReadV36()>>BUTTON_PINS[i])&0x01;buttonLastRaw[i]=s;buttonStable[i]=s;buttonChangedAt[i]=millis();buttonLongSent[i]=false;}
  Serial.printf("BOOT> 08 tombol dibaca, byte PCF8574 = 0x%02X\n",(unsigned)pcf8574ReadV36());
  Serial.flush();
  // FIX 6 Sep 2026: applyGnssUpdateRateV36()/applyGnssSystemV36() TIDAK dipanggil di sini lagi.
  // Dulu dipanggil di baris ini -- padahal gpsSerial.begin() baru terjadi di dalam
  // detectAndConfigureGpsV32() beberapa baris di bawah, jadi command UBX-nya dikirim ke
  // UART yang belum aktif dan hilang diam-diam. Sekarang setting user diterapkan di
  // configureMg90225HzV30() yang dipanggil dari detectAndConfigureGpsV32() (UART sudah hidup).
  prefsV31.begin("rs16v31",false);BOOTMARK_V36("09 NVS/preferences terbuka");
  loadSettingsV31();loadCompareV36();BOOTMARK_V36("10 setting dimuat");
  initImuV31();Serial.printf("BOOT> 11 IMU = %s (%s)\n",imuChipNameV36(),imuConnectedV31?"TERDETEKSI":"TIDAK TERDETEKSI");Serial.flush();
  updateBatteryV31(true);Serial.printf("BOOT> 12 baterai = %.2f V\n",batteryVoltageV31);Serial.flush();
  lcdInit();BOOTMARK_V36("13 LCD di-init");
  drawOpening();BOOTMARK_V36("14 opening screen digambar");
  detectAndConfigureGpsV32();BOOTMARK_V36("15 GPS selesai dideteksi");
  initSdV31();BOOTMARK_V36("16 storage dicek");
