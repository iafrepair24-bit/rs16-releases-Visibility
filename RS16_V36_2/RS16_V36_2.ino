static uint16_t ubxU2V30(const uint8_t* p, uint16_t o) {
  return (uint16_t)p[o] | ((uint16_t)p[o + 1] << 8);
}
static uint32_t ubxU4V30(const uint8_t* p, uint16_t o) {
  return (uint32_t)p[o] | ((uint32_t)p[o + 1] << 8) |
         ((uint32_t)p[o + 2] << 16) | ((uint32_t)p[o + 3] << 24);
}
static int32_t ubxI4V30(const uint8_t* p, uint16_t o) {
  return (int32_t)ubxU4V30(p, o);
}

static uint32_t gpsTowDeltaMsV30(uint32_t newerTow, uint32_t olderTow) {
  if (newerTow >= olderTow) return newerTow - olderTow;
  return GPS_WEEK_MS_V30 - olderTow + newerTow;
}

static uint32_t gpsTowInterpolateV30(uint32_t olderTow, uint32_t newerTow, float ratio) {
  ratio = constrain(ratio, 0.0f, 1.0f);
  uint32_t dt = gpsTowDeltaMsV30(newerTow, olderTow);
  uint32_t add = (uint32_t)(ratio * (float)dt + 0.5f);
  uint32_t value = olderTow + add;
  if (value >= GPS_WEEK_MS_V30) value -= GPS_WEEK_MS_V30;
  return value;
}

static float gpsDistanceMetersV30(double lat1, double lon1, double lat2, double lon2) {
  // Equirectangular approximation is accurate and cheap for 25 Hz short steps.
  const double DEG_TO_RAD_D = 0.017453292519943295;
  const double EARTH_R_M = 6371000.0;
  double p1 = lat1 * DEG_TO_RAD_D;
  double p2 = lat2 * DEG_TO_RAD_D;
  double dLat = (lat2 - lat1) * DEG_TO_RAD_D;
  double dLon = (lon2 - lon1) * DEG_TO_RAD_D;
  double x = dLon * cos((p1 + p2) * 0.5);
  double y = dLat;
  return (float)(sqrt(x * x + y * y) * EARTH_R_M);
}

static void sendUbxV30(uint8_t cls, uint8_t id, const uint8_t* payload, uint16_t len) {
  uint8_t ckA = 0, ckB = 0;
  gpsSerial.write(0xB5); gpsSerial.write(0x62);
  gpsSerial.write(cls); ckA += cls; ckB += ckA;
  gpsSerial.write(id); ckA += id; ckB += ckA;
  uint8_t l = len & 0xFF, h = (len >> 8) & 0xFF;
  gpsSerial.write(l); ckA += l; ckB += ckA;
  gpsSerial.write(h); ckA += h; ckB += ckA;
  for (uint16_t i = 0; i < len; ++i) {
    gpsSerial.write(payload[i]); ckA += payload[i]; ckB += ckA;
  }
  gpsSerial.write(ckA); gpsSerial.write(ckB);
  gpsSerial.flush();
}

static void setUbxMessageRateV30(uint8_t msgClass, uint8_t msgId, uint8_t uart1Rate) {
  const uint8_t payload[] = {msgClass, msgId, 0x00, uart1Rate, 0x00, 0x00, 0x00, 0x00};
  sendUbxV30(0x06, 0x01, payload, sizeof(payload));
  delay(15);
}


static bool sniffGpsBaudV32(uint32_t baud, uint32_t listenMs) {
  gpsSerial.flush();
  gpsSerial.end();
  delay(35);
  gpsSerial.setRxBufferSize(4096);
  gpsSerial.begin(baud, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);

  const uint32_t start = millis();
  uint32_t byteCount = 0;
  uint8_t prev = 0;
  uint8_t nmeaState = 0;
  bool ubxSeen = false;
  bool nmeaSeen = false;

  while (millis() - start < listenMs) {
    while (gpsSerial.available() > 0) {
      const uint8_t b = (uint8_t)gpsSerial.read();
      byteCount++;

      if (prev == 0xB5 && b == 0x62) ubxSeen = true;

      if (nmeaState == 0) {
        if (b == '$') nmeaState = 1;
      } else if (nmeaState == 1) {
        if (b == 'G' || b == 'B') nmeaState = 2;
        else nmeaState = (b == '$') ? 1 : 0;
      } else {
        if (b >= 'A' && b <= 'Z') nmeaSeen = true;
        nmeaState = 0;
      }

      prev = b;
      if ((ubxSeen || nmeaSeen) && byteCount >= 8) break;
    }
    if ((ubxSeen || nmeaSeen) && byteCount >= 8) break;
    delay(1);
  }

  if (ubxSeen || nmeaSeen) {
    gpsActiveBaudV32 = baud;
    gpsProtocolDetectedV32 = true;
    gpsUbxDetectedV32 = ubxSeen;
    gpsNmeaDetectedV32 = nmeaSeen;
    gpsLastByteMillisV32 = millis();
    Serial.printf("GNSS DETECT baud=%lu protocol=%s%s bytes=%lu\n",
                  (unsigned long)baud,
                  ubxSeen ? "UBX" : "",
                  nmeaSeen ? (ubxSeen ? "+NMEA" : "NMEA") : "",
                  (unsigned long)byteCount);
    return true;
  }

  Serial.printf("GNSS SCAN baud=%lu no valid protocol, bytes=%lu\n",
                (unsigned long)baud, (unsigned long)byteCount);
  return false;
}

static void setGpsPort115200V32() {
  // UBX-CFG-PRT UART1: 8N1, 115200 baud.
  // Keep UBX+NMEA input/output during the baud switch; NMEA is disabled
  // afterwards by configureMg90225HzV30().
  const uint8_t payload[20] = {
    0x01, 0x00, 0x00, 0x00,
    0xD0, 0x08, 0x00, 0x00,
    0x00, 0xC2, 0x01, 0x00,
    0x07, 0x00,
    0x03, 0x00,
    0x00, 0x00,
    0x00, 0x00
  };
  sendUbxV30(0x06, 0x00, payload, sizeof(payload));
  delay(180);

  gpsSerial.flush();
  gpsSerial.end();
  delay(50);
  gpsSerial.setRxBufferSize(4096);
  gpsSerial.begin(115200, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  gpsActiveBaudV32 = 115200;
  delay(250);
}

static void configureMg90225HzV30();   // V36.2: forward decl eksplisit (dulu bergantung prototype otomatis IDE)

static bool detectAndConfigureGpsV32() {
  gpsProtocolDetectedV32 = false;
  gpsUbxDetectedV32 = false;
  gpsNmeaDetectedV32 = false;

  // MG-902 expected setting first. Other common baud rates are fallbacks
  // so a module with reset/default UART is recovered automatically.
  static const uint32_t baudList[] = {115200UL, 9600UL, 38400UL, 57600UL, 230400UL};
  static const uint16_t listenMs[]  = {1400, 1100, 1100, 1100, 1100};

  bool found = false;
  for (uint8_t i = 0; i < sizeof(baudList) / sizeof(baudList[0]); ++i) {
    if (sniffGpsBaudV32(baudList[i], listenMs[i])) {
      found = true;
      break;
    }
  }

  if (!found) {
    // Keep expected UART alive. No fake SAT/FIX values are generated.
    gpsSerial.end();
    delay(30);
    gpsSerial.setRxBufferSize(4096);
    gpsSerial.begin(115200, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
    gpsActiveBaudV32 = 115200;
    gpsLastAutoDetectMillisV32 = millis();
    Serial.println("GNSS DETECT: no UART protocol found; waiting on 115200");
    return false;
  }

  if (gpsActiveBaudV32 != 115200UL) {
    Serial.printf("GNSS: switching UART %lu -> 115200\n",
                  (unsigned long)gpsActiveBaudV32);
    setGpsPort115200V32();
  } else {
    gpsSerial.end();
    delay(30);
    gpsSerial.setRxBufferSize(4096);
    gpsSerial.begin(115200, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
    delay(180);
  }

  while (gpsSerial.available() > 0) gpsSerial.read();
  configureMg90225HzV30();
  gpsLastAutoDetectMillisV32 = millis();
  return true;
}

// ---------- V36.1 GNSS MODE: update rate, pilihan sistem GNSS, cold start ----------
// FIX 6 Sep 2026: dua variabel di bawah DIPINDAH KE ATAS (dulu dideklarasikan setelah
// configureMg90225HzV30) supaya konfigurasi dasar GNSS menghormati pilihan user.
// Dulu configureMg90225HzV30() hardcode 25Hz dan SELALU menimpa balik setting user
// tiap kali dipanggil (boot, recovery PVT, perintah serial) -> pilihan 10 Hz tidak
// pernah bertahan setelah restart.
static uint8_t gnssUpdateRateIdxV36 = 1;   // 0 = 10 Hz, 1 = 25 Hz
static uint8_t gnssSystemIdxV36 = 4;       // lihat GNSS_SYSTEM_NAME_V36
static void applyGnssSystemV36();          // forward decl -- dipakai di configureMg90225HzV30()

static inline uint8_t gnssRateHzV36(){ return gnssUpdateRateIdxV36 == 0 ? 10 : 25; }

// V36.2: rate + pesan UBX saja (TANPA CFG-GNSS). Dipakai juga oleh recovery stream --
// dulu recovery ikut mengirim CFG-GNSS, padahal mengubah konfigurasi konstelasi bisa memicu
// restart GNSS di modul (fix hilang lagi) tepat saat stream sedang bermasalah.
static void configureGnssRateMsgsV36() {
  // UBX-CFG-RATE mengikuti pilihan user: 100 ms (10 Hz) atau 40 ms (25 Hz).
  const uint16_t meas = (gnssUpdateRateIdxV36 == 0) ? 100 : 40;
  const uint8_t ratePayload[] = {(uint8_t)(meas & 0xFF), (uint8_t)(meas >> 8), 0x01, 0x00, 0x01, 0x00};
  sendUbxV30(0x06, 0x08, ratePayload, sizeof(ratePayload));
  delay(40);

  setUbxMessageRateV30(0x01, 0x07, 1); // UBX-NAV-PVT tiap solusi = rate penuh
  setUbxMessageRateV30(0x01, 0x04, (gnssUpdateRateIdxV36 == 0) ? 2 : 5);   // UBX-NAV-DOP ~5 Hz
  setUbxMessageRateV30(0x01, 0x35, (gnssUpdateRateIdxV36 == 0) ? 5 : 12);  // UBX-NAV-SAT ~2 Hz (layar sinyal lebih responsif)

  // Disable standard NMEA sentences on UART1. UBX stream stays deterministic.
  static const uint8_t nmeaIds[] = {0x00,0x01,0x02,0x03,0x04,0x05};
  for (uint8_t i = 0; i < sizeof(nmeaIds); ++i) setUbxMessageRateV30(0xF0, nmeaIds[i], 0);

  Serial.printf("GNSS: MG-902 115200, UBX-PVT %u Hz, NMEA OFF\n", (unsigned)gnssRateHzV36());
}

static void configureMg90225HzV30() {
  configureGnssRateMsgsV36();
  // Konstelasi dikirim saat boot/deteksi ulang saja, supaya pilihan GNSS SYSTEM user berlaku.
  applyGnssSystemV36();
}

