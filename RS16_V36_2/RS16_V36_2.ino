// ---------- V36.1 MENU UTAMA: grid kotak dihapus, hanya yang terpilih yang berkotak ----------
// Panel/kotak tiap kartu di RS16_MENU_RLE ditimpa warna background sehingga yang tersisa
// cuma icon + labelnya. Tabel RS16_MENU_RLE aslinya TIDAK diubah sama sekali.
// ---------- V36.1 MENU UTAMA (direvisi 12 Sep 2026) ----------
// Panel/kotak tiap kartu SUDAH TIDAK ADA lagi di RS16_MENU_RLE -- bitmap-nya sudah
// di-generate ulang tanpa panel sama sekali, jadi tabel penghapus grid (RS16_MENU_ERASE_*)
// dan drawMenuGridEraseV36() dihapus: tidak ada lagi yang perlu dihapus, dan cara lama
// memang menyisakan garis tipis karena masknya tidak lengkap.
// Icon TIDAK diubah sedikit pun -- diambil piksel-per-piksel dari bitmap lama.
// Label digambar ulang anti-alias (Poppins Medium 9px) supaya tepinya halus.

// Frame seleksi: kotak putih 1px, sudut membulat, UKURAN SERAGAM untuk semua kartu supaya
// tidak berubah-ubah besarnya saat kursor pindah (icon tiap menu ukurannya beda-beda).
static const int16_t MENU_SEL_W_V36 = 64;
static const int16_t MENU_SEL_H_V36 = 62;
static const int16_t MENU_SEL_R_V36 = 8;
static const int16_t MENU_SEL_CY_V36[8] = {72,72,72,72,164,164,164,164};

static void drawMenuSelectBoxV36(uint8_t index){
  if(index>7)return;
  const int16_t cx=CARD_X[index]+CARD_W/2;
  const int16_t x1=cx-MENU_SEL_W_V36/2, x2=cx+MENU_SEL_W_V36/2-1;
  const int16_t y1=MENU_SEL_CY_V36[index]-MENU_SEL_H_V36/2;
  const int16_t y2=MENU_SEL_CY_V36[index]+MENU_SEL_H_V36/2-1;
  const int16_t r=MENU_SEL_R_V36;
  const uint16_t col=C_V31_WHITE;
  drawHLineV31(x1+r, y1, x2-x1+1-2*r, col);
  drawHLineV31(x1+r, y2, x2-x1+1-2*r, col);
  drawVLineV31(x1, y1+r, y2-y1+1-2*r, col);
  drawVLineV31(x2, y1+r, y2-y1+1-2*r, col);
  int16_t f=1-r, ddx=1, ddy=-2*r, x=0, y=r;
  while(x<y){
    if(f>=0){ y--; ddy+=2; f+=ddy; }
    x++; ddx+=2; f+=ddx;
    fillRect(x1+r-x, y1+r-y, 1,1, col); fillRect(x2-r+x, y1+r-y, 1,1, col);
    fillRect(x1+r-y, y1+r-x, 1,1, col); fillRect(x2-r+y, y1+r-x, 1,1, col);
    fillRect(x1+r-x, y2-r+y, 1,1, col); fillRect(x2-r+x, y2-r+y, 1,1, col);
    fillRect(x1+r-y, y2-r+x, 1,1, col); fillRect(x2-r+y, y2-r+x, 1,1, col);
  }
}

void drawSelectedMenu(uint8_t index) {
  drawMenuBitmap();
  drawTopBarStatusOnlyV32();

  // V36.1 hanya menu terpilih yang dikasih kotak (sudut membulat halus, abu-abu)
  drawMenuSelectBoxV36(index);

  Serial.print("SELECTED: ");
  Serial.println(MENU_NAMES[index]);
}

