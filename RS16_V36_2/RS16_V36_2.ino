static void drawWifiIconV34(bool enabled){
  const int16_t x=44, y=4;
  const uint32_t count = enabled ? RS16_WIFI_ON_V34_RLE_COUNT : RS16_WIFI_OFF_V34_RLE_COUNT;
  if(fbActiveV36){   // V36.2: versi framebuffer
    uint32_t p=0;
    for(uint32_t i=0;i<count;i++){
      uint16_t n = enabled ? pgm_read_word(&RS16_WIFI_ON_V34_RLE[i].count) : pgm_read_word(&RS16_WIFI_OFF_V34_RLE[i].count);
      const uint16_t color = enabled ? pgm_read_word(&RS16_WIFI_ON_V34_RLE[i].color) : pgm_read_word(&RS16_WIFI_OFF_V34_RLE[i].color);
      while(n--){ fillRect(x+(int16_t)(p%24),y+(int16_t)(p/24),1,1,color); p++; }
    }
    return;
  }
  lcdStartWrite();
  lcdSetWindowTx(x,y,x+23,y+19);

  for(uint32_t i=0;i<count;i++){
    uint16_t pixelCount = enabled
      ? pgm_read_word(&RS16_WIFI_ON_V34_RLE[i].count)
      : pgm_read_word(&RS16_WIFI_OFF_V34_RLE[i].count);
    uint16_t color = enabled
      ? pgm_read_word(&RS16_WIFI_ON_V34_RLE[i].color)
      : pgm_read_word(&RS16_WIFI_OFF_V34_RLE[i].color);
    uint8_t hi=color>>8, lo=color&0xFF;
    while(pixelCount--){
      lcdSPI.transfer(hi);
      lcdSPI.transfer(lo);
    }
  }
  lcdEndWrite();
}

