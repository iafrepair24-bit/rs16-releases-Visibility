static const char* const GNSS_SYSTEM_NAME_V36[5] = {"GPS + GLONASS","GPS + GLONASS + QZSS","GPS + GALILEO + QZSS","GPS + BEIDOU","ALL SYSTEM"};

static void applyGnssUpdateRateV36(){
  configureGnssRateMsgsV36();
  Serial.printf("GNSS UPDATE RATE -> %u HZ\n",(unsigned)gnssRateHzV36());
}

// UBX-CFG-GNSS: 7 blok konfigurasi konstelasi
static void applyGnssSystemV36(){
  bool glo=false,gal=false,bds=false,qzss=false;
  switch(gnssSystemIdxV36){
    case 0: glo=true; break;                       // GPS + GLONASS
    case 1: glo=true; qzss=true; break;            // GPS + GLONASS + QZSS
    case 2: gal=true; qzss=true; break;            // GPS + GALILEO + QZSS
    case 3: bds=true; break;                       // GPS + BEIDOU
    default: glo=true; gal=true; bds=true; qzss=true; break;  // ALL
  }
  uint8_t pl[4+7*8];
  memset(pl,0,sizeof(pl));
  pl[0]=0x00; pl[1]=0x00; pl[2]=0xFF; pl[3]=7;   // msgVer, numTrkChHw, numTrkChUse, numConfigBlocks
  struct{uint8_t id,resTrk,maxTrk;bool en;} blk[7]={
    {0,8,16,true},    // GPS
    {1,1,3,true},     // SBAS
    {2,4,8,gal},      // Galileo
    {3,8,16,bds},     // BeiDou
    {4,0,8,false},    // IMES
    {5,0,3,qzss},     // QZSS
    {6,8,14,glo}      // GLONASS
  };
  for(uint8_t i=0;i<7;i++){
    uint8_t* b=&pl[4+i*8];
    b[0]=blk[i].id; b[1]=blk[i].resTrk; b[2]=blk[i].maxTrk; b[3]=0;
    uint32_t flags=(blk[i].en?1UL:0UL)|(0x01UL<<16);   // enable + sinyal L1 default
    b[4]=(uint8_t)(flags&0xFF); b[5]=(uint8_t)((flags>>8)&0xFF);
    b[6]=(uint8_t)((flags>>16)&0xFF); b[7]=(uint8_t)((flags>>24)&0xFF);
  }
  sendUbxV30(0x06,0x3E,pl,sizeof(pl));
  Serial.printf("GNSS SYSTEM -> %s\n",GNSS_SYSTEM_NAME_V36[gnssSystemIdxV36<5?gnssSystemIdxV36:4]);
}

// UBX-CFG-RST: cold start (hapus data satelit lama)
static void gnssColdStartV36(){
  const uint8_t pl[4]={0xFF,0xFF,0x02,0x00};   // navBbrMask=0xFFFF (cold), resetMode=controlled GNSS restart
  sendUbxV30(0x06,0x04,pl,sizeof(pl));
  gnssColdStartMsV36=millis();
  Serial.println("GNSS COLD START DIKIRIM - JANGAN DIPUTUS SAMPAI SELESAI");
}

static void updateGpsLockV30() {
  const uint32_t now = millis();
  const bool quality = gpsFixRawV30 &&
                       gpsFixTypeV30 >= 3 &&
                       gpsSatellitesV30 >= GPS_MIN_SATS_V30 &&
                       (!gpsHdopValidV30 || gpsHdopV30 <= GPS_MAX_HDOP_V30) &&
                       gpsHorizontalAccuracyM_V30 <= 25.0f;

  if (quality) {
    gpsLostSinceV30 = 0;
    if (!gpsFixLockedV30) {
      if (gpsLockCandidateSinceV30 == 0) gpsLockCandidateSinceV30 = now;
      if (now - gpsLockCandidateSinceV30 >= GPS_LOCK_CONFIRM_MS_V30) {
        gpsFixLockedV30 = true;
        Serial.printf("GNSS LOCK SAT=%u HDOP=%.2f HACC=%.2fm\n",
                      gpsSatellitesV30, gpsHdopV30, gpsHorizontalAccuracyM_V30);
      }
    }
  } else {
    gpsLockCandidateSinceV30 = 0;
    if (gpsFixLockedV30) {
      if (gpsLostSinceV30 == 0) gpsLostSinceV30 = now;
      if (now - gpsLostSinceV30 >= GPS_LOCK_RELEASE_MS_V30) {
        gpsFixLockedV30 = false;
        Serial.println("GNSS LOCK RELEASED");
      }
    }
  }
}

static void handleUbxPacketV30(uint8_t cls, uint8_t id, const uint8_t* p, uint16_t len) {
  if (cls != 0x01) return;

  if (id == 0x07 && len >= 92) { // NAV-PVT
    const uint32_t newTowV31 = ubxU4V30(p, 0);
    if (gpsHaveAcceptedTowV31 && newTowV31 == gpsITowMsV30) return;
    gpsHaveAcceptedTowV31 = true;
    gpsPvtPacketsV30++;
    gpsITowMsV30 = newTowV31;
    gpsYearV30 = ubxU2V30(p, 4);
    gpsMonthV30 = p[6]; gpsDayV30 = p[7];
    gpsHourV30 = p[8]; gpsMinuteV30 = p[9]; gpsSecondV30 = p[10];
    gpsTimeValidV34 = ((p[11] & 0x02) != 0);
    gpsDateTimeValidV30 = ((p[11] & 0x03) == 0x03);
    if(gpsTimeValidV34 && gpsHourV30 < 24 && gpsMinuteV30 < 60 && gpsSecondV30 < 60){
      gpsClockBaseUtcSecV35 =
        (uint32_t)gpsHourV30 * 3600UL +
        (uint32_t)gpsMinuteV30 * 60UL +
        (uint32_t)gpsSecondV30;
      gpsClockBaseMillisV35 = millis();
      gpsClockSyncedV35 = true;
    }
    gpsFixTypeV30 = p[20];
    const uint8_t flags = p[21];
    gpsSatellitesV30 = p[23];
    gpsLongitudeV30 = (double)ubxI4V30(p, 24) * 1e-7;
    gpsLatitudeV30 = (double)ubxI4V30(p, 28) * 1e-7;
    gpsHorizontalAccuracyM_V30 = (float)ubxU4V30(p, 40) * 0.001f;
    gpsSpeedKmhV30 = (float)ubxI4V30(p, 60) * 0.0036f;
    if (gpsSpeedKmhV30 < 0.0f) gpsSpeedKmhV30 = 0.0f;
    gpsHeadingDegV30 = (float)ubxI4V30(p, 64) * 1e-5f;
    gpsSpeedAccuracyKmhV30 = (float)ubxU4V30(p, 68) * 0.0036f;
    gpsFixRawV30 = ((flags & 0x01) != 0) && gpsFixTypeV30 >= 2;
    gpsLastPvtMillisV30 = millis();
    gpsPvtSequenceV30++;

    uint32_t now = gpsLastPvtMillisV30;
    if (gpsRateWindowStartV30 == 0) gpsRateWindowStartV30 = now;
    gpsRateWindowCountV30++;
    uint32_t elapsed = now - gpsRateWindowStartV30;
    if (elapsed >= 1000UL) {
      gpsActualRateHzV30 = gpsRateWindowCountV30 * 1000.0f / (float)elapsed;
      gpsRateWindowCountV30 = 0;
      gpsRateWindowStartV30 = now;
    }
    updateGpsLockV30();
    return;
  }


  if (id == 0x35 && len >= 8) { // NAV-SAT
    gpsSatUsedV31 = 0;
    gpsConstGpsV31 = gpsConstGloV31 = gpsConstGalV31 = gpsConstBdsV31 = gpsConstSbasV31 = 0;
    gpsCnoMaxV31 = 0; gpsCnoSumV31 = 0; gpsCnoCountV31 = 0;
    gpsSatViewCountV32 = 0;

    const uint8_t numSvs = p[5];
    for (uint8_t i = 0; i < numSvs; ++i) {
      const uint16_t o = 8U + (uint16_t)i * 12U;
      if (o + 11U >= len) break;

      const uint8_t gnssId = p[o + 0];
      const uint8_t svId = p[o + 1];
      const uint8_t cno = p[o + 2];
      const uint32_t flagsSat = ubxU4V30(p, o + 8);
      const bool used = (flagsSat & (1UL << 3)) != 0;

      if (used) gpsSatUsedV31++;
      if (cno > 0) {
        if (cno > gpsCnoMaxV31) gpsCnoMaxV31 = cno;
        gpsCnoSumV31 += cno;
        gpsCnoCountV31++;
      }

      if (gnssId == 0) gpsConstGpsV31++;
      else if (gnssId == 1) gpsConstSbasV31++;
      else if (gnssId == 2) gpsConstGalV31++;
      else if (gnssId == 3) gpsConstBdsV31++;
      else if (gnssId == 6) gpsConstGloV31++;

      if (gpsSatViewCountV32 < GPS_SAT_VIEW_MAX_V32 && cno > 0) {
        const uint8_t k = gpsSatViewCountV32++;
        gpsSatViewIdV32[k] = svId;
        gpsSatViewCnoV32[k] = cno;
        gpsSatViewGnssV32[k] = gnssId;
        gpsSatViewUsedV32[k] = used;
      }
    }
    return;
  }

  if (id == 0x04 && len >= 18) { // NAV-DOP
    gpsHdopV30 = ubxU2V30(p, 12) * 0.01f;
    gpsHdopValidV30 = gpsHdopV30 > 0.0f && gpsHdopV30 < 99.0f;
    updateGpsLockV30();
  }
}

enum UbxStateV30 : uint8_t {
  UBX_SYNC1_V30, UBX_SYNC2_V30, UBX_CLASS_V30, UBX_ID_V30,
  UBX_LEN1_V30, UBX_LEN2_V30, UBX_PAYLOAD_V30, UBX_CKA_V30, UBX_CKB_V30
};
static UbxStateV30 ubxStateV30 = UBX_SYNC1_V30;
static uint8_t ubxClassV30 = 0, ubxIdV30 = 0, ubxCkAV30 = 0, ubxCkBV30 = 0;
static uint8_t ubxPayloadV30[1024];   // V36.2: 512 -> 1024. NAV-SAT = 8+12*numSvs; >42 SV dulu dibuang utuh
static uint16_t ubxLenV30 = 0, ubxPosV30 = 0;
static bool ubxStoreV30 = true, ubxCkAOkV30 = false;

static void ubxChecksumAddV30(uint8_t b) { ubxCkAV30 += b; ubxCkBV30 += ubxCkAV30; }

static void parseUbxByteV30(uint8_t b) {
  switch (ubxStateV30) {
    case UBX_SYNC1_V30:
      if (b == 0xB5) ubxStateV30 = UBX_SYNC2_V30;
      break;
    case UBX_SYNC2_V30:
      ubxStateV30 = (b == 0x62) ? UBX_CLASS_V30 : UBX_SYNC1_V30;
      break;
    case UBX_CLASS_V30:
      ubxClassV30 = b; ubxCkAV30 = 0; ubxCkBV30 = 0; ubxChecksumAddV30(b);
      ubxStateV30 = UBX_ID_V30; break;
    case UBX_ID_V30:
      ubxIdV30 = b; ubxChecksumAddV30(b); ubxStateV30 = UBX_LEN1_V30; break;
    case UBX_LEN1_V30:
      ubxLenV30 = b; ubxChecksumAddV30(b); ubxStateV30 = UBX_LEN2_V30; break;
    case UBX_LEN2_V30:
      ubxLenV30 |= ((uint16_t)b << 8); ubxChecksumAddV30(b);
      ubxPosV30 = 0; ubxStoreV30 = ubxLenV30 <= sizeof(ubxPayloadV30);
      ubxStateV30 = ubxLenV30 ? UBX_PAYLOAD_V30 : UBX_CKA_V30; break;
    case UBX_PAYLOAD_V30:
      if (ubxStoreV30 && ubxPosV30 < sizeof(ubxPayloadV30)) ubxPayloadV30[ubxPosV30] = b;
      ubxPosV30++; ubxChecksumAddV30(b);
      if (ubxPosV30 >= ubxLenV30) ubxStateV30 = UBX_CKA_V30;
      break;
    case UBX_CKA_V30:
      ubxCkAOkV30 = (b == ubxCkAV30); ubxStateV30 = UBX_CKB_V30; break;
    case UBX_CKB_V30:
      if (ubxCkAOkV30 && b == ubxCkBV30) {
        if (ubxStoreV30) handleUbxPacketV30(ubxClassV30, ubxIdV30, ubxPayloadV30, ubxLenV30);
      } else {
        gpsChecksumErrorsV30++;
      }
      ubxStateV30 = UBX_SYNC1_V30;
      break;
  }
}

static void serviceGps25HzV30() {
  while (gpsSerial.available() > 0) {
    uint8_t b = (uint8_t)gpsSerial.read();
    gpsBytesRxV30++;
    gpsLastByteMillisV32 = millis();
    parseUbxByteV30(b);
  }
  // Release stale lock even when no packet arrives at all.
  if (gpsFixLockedV30 && millis() - gpsLastPvtMillisV30 > GPS_LOCK_RELEASE_MS_V30) {
    gpsFixRawV30 = false;
    updateGpsLockV30();
  }
  const uint32_t nowV31 = millis();
  if (gpsLastPvtMillisV30 != 0 && nowV31 - gpsLastPvtMillisV30 > 2500UL &&
      nowV31 - gpsLastRecoveryMsV31 > 5000UL) {
    gpsLastRecoveryMsV31 = nowV31;
    Serial.println("GNSS stream stale - reapply rate config");
    configureGnssRateMsgsV36();
  }
}
static bool gpsReadyV30() {
  if(gpsLastPvtMillisV30==0) return false;
  if(millis()-gpsLastPvtMillisV30>1200UL) return false;
  return gpsFixRawV30 && gpsFixTypeV30>=3 && gpsSatellitesV30>=4;
}

static void printGpsDiagnosticV30() {
  uint32_t now = millis();
  if (now - gpsDiagLastMsV30 < 2000UL) return;
  gpsDiagLastMsV30 = now;
  Serial.printf("GNSS25 FIX=%s TYPE=%u SAT=%u HDOP=%.2f RATE=%.1fHz SPD=%.2f HACC=%.2f SACC=%.2f PVT=%lu ERR=%lu\n",
                gpsReadyV30() ? "LOCK" : "WAIT", gpsFixTypeV30, gpsSatellitesV30,
                gpsHdopV30, gpsActualRateHzV30, gpsSpeedKmhV30,
                gpsHorizontalAccuracyM_V30, gpsSpeedAccuracyKmhV30,
                (unsigned long)gpsPvtPacketsV30, (unsigned long)gpsChecksumErrorsV30);
}


static const int16_t LCD_W = 320;
static const int16_t LCD_H = 240;
static const uint32_t LCD_SPI_HZ = 20000000UL;

static const uint16_t C_BLACK = 0x0000;

// FIX 12 Sep 2026 -- BUG PENYEBAB LAYAR PUTIH.
// Dulu baris ini `SPIClass lcdSPI(FSPI);`. Di ESP32-S3 (target kode aslinya) FSPI memang bus
// serbaguna yang sah. TAPI di ESP32 KLASIK (WROOM-32, papan produksi ini) FSPI = SPI1 = bus yang
// menempel ke FLASH INTERNAL -- bukan bus untuk peranti user. Akibatnya data TFT tidak pernah
// benar-benar keluar, controller ILI9341 tidak pernah terinisialisasi, dan layar cuma putih polos
// (lampu latar tetap menyala karena disuplai terpisah dari 3V3).
// Dokumentasi Arduino-ESP32: di ESP32 klasik hanya HSPI dan VSPI yang tersedia untuk user.
// VSPI dipilih karena pin papan ini (SCK=18, MISO=19, MOSI=23) PERSIS pin IO_MUX bawaan VSPI,
// jadi SPI bisa jalan lewat jalur cepat, bukan lewat GPIO matrix.
// HSPI tidak dipakai di sini karena sudah dipegang objek sdSpiV31.
// Papan RS16 produksi memakai ESP32-WROOM-32 (ESP32 KLASIK). BUKAN S3, BUKAN C3/S2.
// Guard di bawah sengaja bikin compile GAGAL kalau board yang dipilih salah -- lebih baik
// ditolak dengan pesan jelas daripada diam-diam memilih bus SPI yang keliru seperti bug lama.
// Di Arduino IDE pilih: Tools > Board > ESP32 Arduino > "ESP32 Dev Module".
#if !defined(CONFIG_IDF_TARGET_ESP32)
#error "BOARD SALAH. Firmware RS16 ini khusus ESP32-WROOM-32 (ESP32 klasik). Pilih 'ESP32 Dev Module' di Tools > Board, jangan varian S3/S2/C3."
#endif
SPIClass lcdSPI(VSPI);   // VSPI = satu-satunya pilihan yang benar di sini (HSPI sudah dipakai sdSpiV31)
static uint8_t solidPixelBuffer[256];

// ============================================================
// RAW SPI ILI9341 DRIVER
// ============================================================

// ============================================================
// V36.2 FRAMEBUFFER ANTI-KEDIP (8-bit palette, 320x240 = 76,8 KB heap)
// Layar dinamis digambar dulu ke RAM, lalu hanya BARIS yang berubah yang dikirim ke LCD.
// Dulu tiap 100 ms layar di-fillScreen hitam lalu digambar ulang langsung ke LCD -> kedip.
// Setiap penulisan LCD langsung (bitmap menu, top bar) otomatis membatalkan cache baris,
// sehingga flush berikutnya mengirim layar penuh dan isi LCD selalu konsisten.
// ============================================================
static uint8_t* fbV36 = nullptr;
static bool fbActiveV36 = false;
static bool fbFlushingV36 = false;
static bool fbCacheValidV36 = false;
static uint16_t fbPalV36[256];
static uint16_t fbPalCountV36 = 0;
static uint32_t fbRowHashV36[240];

static uint8_t fbColorIndexV36(uint16_t c) {
  static uint8_t last = 0;
  if (last < fbPalCountV36 && fbPalV36[last] == c) return last;
  for (uint16_t i = 0; i < fbPalCountV36; i++) if (fbPalV36[i] == c) { last = (uint8_t)i; return last; }
  if (fbPalCountV36 < 256) { fbPalV36[fbPalCountV36] = c; last = (uint8_t)fbPalCountV36++; return last; }
  // Palet penuh (praktis tidak terjadi): pakai warna terdekat.
  int32_t best = 0x7FFFFFFF; uint8_t bi = 0;
  for (uint16_t i = 0; i < 256; i++) {
    const int32_t dr = (int32_t)((fbPalV36[i] >> 11) & 0x1F) - (int32_t)((c >> 11) & 0x1F);
    const int32_t dg = (int32_t)((fbPalV36[i] >> 5) & 0x3F) - (int32_t)((c >> 5) & 0x3F);
    const int32_t db = (int32_t)(fbPalV36[i] & 0x1F) - (int32_t)(c & 0x1F);
    const int32_t d = dr * dr * 4 + dg * dg + db * db * 4;
    if (d < best) { best = d; bi = (uint8_t)i; }
  }
  return bi;
}

void lcdStartWrite() {
  if (!fbFlushingV36) fbCacheValidV36 = false;   // tulis langsung ke LCD -> cache baris FB tidak valid lagi
  lcdSPI.beginTransaction(SPISettings(LCD_SPI_HZ, MSBFIRST, SPI_MODE0));
  digitalWrite(TFT_CS, LOW);
}

void lcdEndWrite() {
  digitalWrite(TFT_CS, HIGH);
  lcdSPI.endTransaction();
}

void lcdWriteCommandTx(uint8_t value) {
  digitalWrite(TFT_DC, LOW);
  lcdSPI.transfer(value);
}

void lcdWriteDataTx(const uint8_t* data, uint32_t length) {
  digitalWrite(TFT_DC, HIGH);
  while (length > 0) {
    uint32_t block = length > 256 ? 256 : length;
    lcdSPI.transferBytes(data, nullptr, block);
    data += block;
    length -= block;
  }
}

void lcdCommand(uint8_t value) {
  lcdStartWrite();
  lcdWriteCommandTx(value);
  lcdEndWrite();
}

void lcdCommandData(uint8_t command, const uint8_t* data, uint8_t length) {
  lcdStartWrite();
  lcdWriteCommandTx(command);
  if (length > 0 && data != nullptr) {
    lcdWriteDataTx(data, length);
  }
  lcdEndWrite();
}

void lcdHardwareReset() {
  digitalWrite(TFT_RST, HIGH);
  delay(20);
  digitalWrite(TFT_RST, LOW);
  delay(60);
  digitalWrite(TFT_RST, HIGH);
  delay(160);
}

void lcdInit() {
  lcdHardwareReset();

  lcdCommand(0x01);
  delay(150);
  lcdCommand(0x28);

  const uint8_t pwr1[] = {0x23};
  const uint8_t pwr2[] = {0x10};
  const uint8_t vcom1[] = {0x3E, 0x28};
  const uint8_t vcom2[] = {0x86};
  const uint8_t madctl[] = {0xE8};
  const uint8_t pixfmt[] = {0x55};
  const uint8_t framerate[] = {0x00, 0x18};
  const uint8_t displayFunction[] = {0x08, 0x82, 0x27};
  const uint8_t gamma[] = {0x01};

  lcdCommandData(0xC0, pwr1, sizeof(pwr1));
  lcdCommandData(0xC1, pwr2, sizeof(pwr2));
  lcdCommandData(0xC5, vcom1, sizeof(vcom1));
  lcdCommandData(0xC7, vcom2, sizeof(vcom2));
  lcdCommandData(0x36, madctl, sizeof(madctl));
  lcdCommandData(0x3A, pixfmt, sizeof(pixfmt));
  lcdCommandData(0xB1, framerate, sizeof(framerate));
  lcdCommandData(0xB6, displayFunction, sizeof(displayFunction));
  lcdCommandData(0x26, gamma, sizeof(gamma));

  lcdCommand(0x11);
  delay(150);
  lcdCommand(0x29);
  delay(100);
}

void lcdSetWindowTx(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
  lcdWriteCommandTx(0x2A);
  digitalWrite(TFT_DC, HIGH);
  lcdSPI.transfer(x0 >> 8);
  lcdSPI.transfer(x0 & 0xFF);
  lcdSPI.transfer(x1 >> 8);
  lcdSPI.transfer(x1 & 0xFF);

  lcdWriteCommandTx(0x2B);
  digitalWrite(TFT_DC, HIGH);
  lcdSPI.transfer(y0 >> 8);
  lcdSPI.transfer(y0 & 0xFF);
  lcdSPI.transfer(y1 >> 8);
  lcdSPI.transfer(y1 & 0xFF);

  lcdWriteCommandTx(0x2C);
  digitalWrite(TFT_DC, HIGH);
}

void fillRect(int16_t x, int16_t y, int16_t width, int16_t height, uint16_t color) {
  // V36.2: clipping. Dulu koordinat di luar layar membuat window ILI9341 "membungkus"
  // dan menggambar sampah di sisi lain layar.
  if (x < 0) { width += x; x = 0; }
  if (y < 0) { height += y; y = 0; }
  if (x + width > LCD_W) width = LCD_W - x;
  if (y + height > LCD_H) height = LCD_H - y;
  if (width <= 0 || height <= 0) return;

  if (fbActiveV36) {
    const uint8_t idx = fbColorIndexV36(color);
    for (int16_t r = 0; r < height; r++) memset(fbV36 + (uint32_t)(y + r) * LCD_W + x, idx, width);
    return;
  }

  const uint8_t highByte = color >> 8;
  const uint8_t lowByte  = color & 0xFF;

  for (uint16_t i = 0; i < sizeof(solidPixelBuffer); i += 2) {
    solidPixelBuffer[i]     = highByte;
    solidPixelBuffer[i + 1] = lowByte;
  }

  uint32_t bytesRemaining = (uint32_t)width * (uint32_t)height * 2UL;

  lcdStartWrite();
  lcdSetWindowTx(x, y, x + width - 1, y + height - 1);

  while (bytesRemaining > 0) {
    uint32_t block =
      bytesRemaining > sizeof(solidPixelBuffer)
        ? sizeof(solidPixelBuffer)
        : bytesRemaining;

    lcdSPI.transferBytes(solidPixelBuffer, nullptr, block);
    bytesRemaining -= block;
  }

  lcdEndWrite();
}

void fillScreen(uint16_t color) {
  fillRect(0, 0, LCD_W, LCD_H, color);
}

// Mulai menggambar ke framebuffer. false = FB tidak tersedia (gambar langsung seperti dulu).
static bool fbBeginV36() {
  if (!fbV36) return false;
  fbActiveV36 = true;
  return true;
}

// Kirim hanya baris yang berubah sejak flush terakhir.
static void fbEndV36() {
  if (!fbActiveV36) return;
  fbActiveV36 = false;
  static uint8_t line[LCD_W * 2];
  static bool changed[LCD_H];
  const bool full = !fbCacheValidV36;
  for (int16_t y = 0; y < LCD_H; y++) {
    const uint32_t* w = (const uint32_t*)(fbV36 + (uint32_t)y * LCD_W);
    uint32_t h = 2166136261UL;
    for (uint16_t i = 0; i < LCD_W / 4; i++) { h ^= w[i]; h *= 16777619UL; }
    changed[y] = full || h != fbRowHashV36[y];
    fbRowHashV36[y] = h;
  }
  fbFlushingV36 = true;
  int16_t y = 0;
  while (y < LCD_H) {
    if (!changed[y]) { y++; continue; }
    int16_t y1 = y;
    while (y1 + 1 < LCD_H && changed[y1 + 1]) y1++;
    lcdStartWrite();
    lcdSetWindowTx(0, y, LCD_W - 1, y1);
    for (int16_t r = y; r <= y1; r++) {
      const uint8_t* src = fbV36 + (uint32_t)r * LCD_W;
      for (uint16_t x = 0; x < LCD_W; x++) {
        const uint16_t c = fbPalV36[src[x]];
        line[x * 2] = c >> 8; line[x * 2 + 1] = c & 0xFF;
      }
      lcdSPI.transferBytes(line, nullptr, sizeof(line));
    }
    lcdEndWrite();
    y = y1 + 1;
  }
  fbFlushingV36 = false;
  fbCacheValidV36 = true;
}

// ============================================================
// V31 LIGHTWEIGHT VECTOR/TEXT PRIMITIVES
// One font + one drawing engine is shared by every dynamic screen.
// ============================================================
static const uint16_t C_V31_BG = 0x0000;
static const uint16_t C_V31_PANEL = 0x0841;
static const uint16_t C_V31_PANEL2 = 0x1082;
static const uint16_t C_V31_EDGE = 0x2945;
