// ---------- battery ----------
#define BATTERY_ADC_PIN_V31 36  // dikoreksi dari 14 -- itu net ICM_AUX_CS, bukan BAT_SENSE. BAT_SENSE asli = GPIO36.
static bool batteryValidV31=false;
static float batteryVoltageV31=0.0f;
static uint8_t batteryPercentV31=0;
static uint32_t batteryLastMsV31=0;
static bool batteryWarnedV31=false;
static uint8_t batteryBeepRemainingV31=0;
static uint32_t batteryNextBeepMsV31=0;
static void startBatteryWarningBeepV31(){batteryBeepRemainingV31=3;batteryNextBeepMsV31=millis();}
// V36.1 proteksi baterai: cutoff aman sebelum sel Li-ion drop terlalu dalam
#define BATTERY_CRITICAL_V_V36 3.35f
static uint8_t batteryCriticalCountV36=0;
static bool batteryProtectActiveV36=false;
static void serviceBatteryWarningBeepV31(){if(!batteryBeepRemainingV31||(int32_t)(millis()-batteryNextBeepMsV31)<0)return;buzzerPlayV31(1200,120);batteryBeepRemainingV31--;batteryNextBeepMsV31=millis()+230UL;}

struct BatteryCurveV31 { uint16_t mv; uint8_t pct; };
static const BatteryCurveV31 BAT_CURVE_V31[]={{4200,100},{4100,90},{4000,80},{3900,70},{3800,55},{3700,40},{3600,25},{3500,12},{3300,5},{3200,0}};
static uint8_t batteryPercentFromMvV31(uint16_t mv){
  const uint8_t n=sizeof(BAT_CURVE_V31)/sizeof(BAT_CURVE_V31[0]); if(mv>=BAT_CURVE_V31[0].mv)return 100; if(mv<=BAT_CURVE_V31[n-1].mv)return 0;
  for(uint8_t i=0;i<n-1;i++){auto hi=BAT_CURVE_V31[i],lo=BAT_CURVE_V31[i+1]; if(mv<=hi.mv&&mv>=lo.mv){
    return lo.pct+(uint32_t)(mv-lo.mv)*(hi.pct-lo.pct)/(hi.mv-lo.mv); }} return 0;
}
static void updateBatteryV31(bool force=false){
  uint32_t now=millis(); if(!force&&now-batteryLastMsV31<1000)return; batteryLastMsV31=now;
  analogRead(BATTERY_ADC_PIN_V31); delayMicroseconds(300); uint32_t sum=0; const uint8_t N=20;
  for(uint8_t i=0;i<N;i++){sum+=analogReadMilliVolts(BATTERY_ADC_PIN_V31);delayMicroseconds(150);} float v=(sum/(float)N)*0.002f;
  if(v>=2.7f&&v<=4.5f){ batteryVoltageV31=batteryValidV31?(batteryVoltageV31*0.8f+v*0.2f):v; batteryValidV31=true;
    batteryPercentV31=batteryPercentFromMvV31((uint16_t)(batteryVoltageV31*1000.0f+0.5f));
    if(batteryPercentV31<=5&&!batteryWarnedV31&&soundLowBatteryV31){batteryWarnedV31=true;startBatteryWarningBeepV31();} if(batteryPercentV31>8)batteryWarnedV31=false;
    // V36.1 hitung kondisi kritis (butuh beberapa pembacaan berturut-turut biar tidak salah trigger)
    if(batteryVoltageV31<=BATTERY_CRITICAL_V_V36){ if(batteryCriticalCountV36<250)batteryCriticalCountV36++; }
    else if(batteryVoltageV31>BATTERY_CRITICAL_V_V36+0.10f) batteryCriticalCountV36=0;
  } else batteryValidV31=false;
}

// ---------- real top bar ----------
static bool localTimeAvailableV34(){
  return gpsClockSyncedV35;
}
static void localTimeTextV31(char* out,size_t n){
  if(!gpsClockSyncedV35){
    snprintf(out,n,"--:--");
    return;
  }

  // Continue from the last REAL GNSS UTC time using ESP millis().
  // Every new valid NAV-PVT time packet re-synchronizes this base.
  uint32_t elapsedSec = (millis() - gpsClockBaseMillisV35) / 1000UL;
  uint32_t utcSec = (gpsClockBaseUtcSecV35 + elapsedSec) % 86400UL;
  uint32_t wibSec = (utcSec + 7UL * 3600UL) % 86400UL;

  uint8_t hh = (uint8_t)(wibSec / 3600UL);
  uint8_t mm = (uint8_t)((wibSec % 3600UL) / 60UL);
  snprintf(out,n,"%02u:%02u",hh,mm);
}


