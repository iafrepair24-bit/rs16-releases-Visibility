static const uint32_t RS16_MENU_RLE_COUNT =
  sizeof(RS16_MENU_RLE) / sizeof(RS16_MENU_RLE[0]);


void drawMenuBitmap() {
  lcdStartWrite();
  lcdSetWindowTx(0, 0, LCD_W - 1, LCD_H - 1);

  for (uint32_t i = 0; i < RS16_MENU_RLE_COUNT; i++) {
    uint16_t pixelCount = pgm_read_word(&RS16_MENU_RLE[i].count);
    uint16_t color      = pgm_read_word(&RS16_MENU_RLE[i].color);

    const uint8_t highByte = color >> 8;
    const uint8_t lowByte  = color & 0xFF;

    for (uint16_t p = 0; p < sizeof(solidPixelBuffer); p += 2) {
      solidPixelBuffer[p]     = highByte;
      solidPixelBuffer[p + 1] = lowByte;
    }

    uint32_t bytesRemaining = static_cast<uint32_t>(pixelCount) * 2UL;

    while (bytesRemaining > 0) {
      uint32_t block =
        bytesRemaining > sizeof(solidPixelBuffer)
          ? sizeof(solidPixelBuffer)
          : bytesRemaining;

      lcdSPI.transferBytes(solidPixelBuffer, nullptr, block);
      bytesRemaining -= block;
    }
  }

  lcdEndWrite();
}













