static const uint32_t RS16_DRAG_PHASE_V11_1_RLE_COUNT =
  sizeof(RS16_DRAG_PHASE_V11_1_RLE) / sizeof(RS16_DRAG_PHASE_V11_1_RLE[0]);

void drawDragPhaseV11_1() {
  lcdStartWrite();
  lcdSetWindowTx(0, 0, LCD_W - 1, LCD_H - 1);
  for (uint32_t i = 0; i < RS16_DRAG_PHASE_V11_1_RLE_COUNT; i++) {
    uint16_t pixelCount = pgm_read_word(&RS16_DRAG_PHASE_V11_1_RLE[i].count);
    uint16_t color      = pgm_read_word(&RS16_DRAG_PHASE_V11_1_RLE[i].color);
    const uint8_t hi = color >> 8;
    const uint8_t lo = color & 0xFF;
    for (uint16_t p = 0; p < sizeof(solidPixelBuffer); p += 2) {
      solidPixelBuffer[p] = hi;
      solidPixelBuffer[p+1] = lo;
    }
    uint32_t bytesRemaining = (uint32_t)pixelCount * 2UL;
    while (bytesRemaining > 0) {
      uint32_t block = bytesRemaining > sizeof(solidPixelBuffer)
        ? sizeof(solidPixelBuffer) : bytesRemaining;
      lcdSPI.transferBytes(solidPixelBuffer, nullptr, block);
      bytesRemaining -= block;
    }
  }
  lcdEndWrite();
}


