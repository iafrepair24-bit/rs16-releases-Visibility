// ---------- stable real-GNSS readiness ----------
// Prevent READY <-> SEARCH flicker from one transient satellite/rate sample.
static bool gpsReadyLatchedV35=false;
static uint32_t gpsReadyCandidateSinceV35=0;
static uint32_t gpsReadyLostSinceV35=0;
static bool gpsCoreReadyV35(){
  if(gpsLastByteMillisV32==0 || millis()-gpsLastByteMillisV32>3000UL)return false;
  if(gpsLastPvtMillisV30==0 || millis()-gpsLastPvtMillisV30>1200UL)return false;
  if(!gpsFixRawV30 || gpsFixTypeV30<3)return false;
  if(gpsEffectiveUsedSatV36()<4)return false;
  return true;
}

static void serviceGpsReadyLatchV35(){
  const uint32_t now=millis();
  const bool core=gpsCoreReadyV35();

  if(core){
    gpsReadyLostSinceV35=0;
    if(!gpsReadyLatchedV35){
      if(gpsReadyCandidateSinceV35==0) gpsReadyCandidateSinceV35=now;
      // Stable real 3D PVT for 600 ms before READY appears.
      if(now-gpsReadyCandidateSinceV35>=600UL){
        gpsReadyLatchedV35=true;
        buzzerPlayV31(2000,80);   // V36.2: bunyi singkat saat GPS lock -> menu fitur terbuka
        screenDirtyV31=true;
        Serial.printf("GPS READY STABLE FIX=%u SAT=%u RATE=%.1f\n",
                      (unsigned)gpsFixTypeV30,(unsigned)gpsSatellitesV30,gpsActualRateHzV30);
      }
    }
  }else{
    gpsReadyCandidateSinceV35=0;

    // Once READY, do not release it because SAT/quality changes for one sample.
    // Release only after a real GNSS loss persists.
    const bool hardLoss =
      gpsLastPvtMillisV30==0 ||
      now-gpsLastPvtMillisV30>1500UL ||
      !gpsFixRawV30 ||
      gpsFixTypeV30<2;

    if(gpsReadyLatchedV35 && hardLoss){
      if(gpsReadyLostSinceV35==0) gpsReadyLostSinceV35=now;
      if(now-gpsReadyLostSinceV35>=2500UL){
        gpsReadyLatchedV35=false;
        gpsReadyLostSinceV35=0;
        Serial.println("GPS READY RELEASED - REAL FIX LOST");
      }
    }else if(!hardLoss){
      gpsReadyLostSinceV35=0;
    }
  }
}

// ---------- stricter timing gate, separate from display lock ----------
static uint8_t gpsTimingReasonV33(){
  if(gpsReadyLatchedV35)return 0;
  if(gpsLastByteMillisV32==0 || millis()-gpsLastByteMillisV32>3000UL)return 1;
  if(gpsLastPvtMillisV30==0 || millis()-gpsLastPvtMillisV30>1200UL)return 2;
  if(!gpsFixRawV30 || gpsFixTypeV30<3)return 3;
  if(gpsEffectiveUsedSatV36()<4)return 4;
  return 5;
}
static const char* gpsTimingReasonTextV33(){
  switch(gpsTimingReasonV33()){
    case 1:return "GPS NO DATA";
    case 2:return "GPS CONFIG";
    case 3:return "WAIT 3D FIX";
    case 4:return "WAIT SAT";
    case 5:return "GPS STABILIZING";
    default:return "READY";
  }
}
static bool gpsTimingReadyV31(){
  return gpsReadyLatchedV35;
}

