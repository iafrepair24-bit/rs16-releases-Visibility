static const uint32_t RS16_OPENING_RLE_COUNT =
  sizeof(RS16_OPENING_RLE) / sizeof(RS16_OPENING_RLE[0]);

void drawRs16OpeningBitmap() {
  // Gunakan driver RAW SPI yang SUDAH ADA pada firmware lama.
  lcdStartWrite();
  lcdSetWindowTx(0, 0, LCD_W - 1, LCD_H - 1);

  for (uint32_t i = 0; i < RS16_OPENING_RLE_COUNT; i++) {
    uint16_t pixelCount = pgm_read_word(&RS16_OPENING_RLE[i].count);
    uint16_t color      = pgm_read_word(&RS16_OPENING_RLE[i].color);

    const uint8_t highByte = color >> 8;
    const uint8_t lowByte  = color & 0xFF;

    // solidPixelBuffer sudah ada di driver RAW SPI firmware lama.
    for (uint16_t p = 0; p < sizeof(solidPixelBuffer); p += 2) {
      solidPixelBuffer[p]     = highByte;
      solidPixelBuffer[p + 1] = lowByte;
    }

    uint32_t bytesRemaining = static_cast<uint32_t>(pixelCount) * 2UL;

    while (bytesRemaining > 0) {
      uint32_t block =
        bytesRemaining > sizeof(solidPixelBuffer)
          ? sizeof(solidPixelBuffer)
          : bytesRemaining;

      lcdSPI.transferBytes(solidPixelBuffer, nullptr, block);
      bytesRemaining -= block;
    }
  }

  lcdEndWrite();
}

void drawOpening() {
  // Bersihkan layar dahulu.
  fillScreen(C_BLACK);
  delay(100);

  // Tampilkan opening RS16 baru.
  drawRs16OpeningBitmap();

  // Lama tampilan opening sebelum masuk ke layar utama.
  delay(1600);
}


