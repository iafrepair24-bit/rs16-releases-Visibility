static bool i2cWriteV31(uint8_t a,uint8_t r,uint8_t v){Wire.beginTransmission(a);Wire.write(r);Wire.write(v);return Wire.endTransmission()==0;}
static bool i2cReadV31(uint8_t a,uint8_t r,uint8_t* b,uint8_t n){Wire.beginTransmission(a);Wire.write(r);if(Wire.endTransmission(false)!=0)return false;uint8_t got=Wire.requestFrom((int)a,(int)n,(int)true);if(got!=n)return false;for(uint8_t i=0;i<n;i++)b[i]=Wire.read();return true;}
// ---- akses register ICM-42688-P lewat SPI (bus dipakai bareng TFT, CS sendiri di ICM_CS_PIN) ----
static void icmWriteRegV36(uint8_t reg,uint8_t val){
  lcdSPI.beginTransaction(SPISettings(1000000,MSBFIRST,SPI_MODE0));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg&0x7F);lcdSPI.transfer(val);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
}
static uint8_t icmReadRegV36(uint8_t reg){
  lcdSPI.beginTransaction(SPISettings(1000000,MSBFIRST,SPI_MODE0));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg|0x80);uint8_t v=lcdSPI.transfer(0x00);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
  return v;
}
static bool icmReadBurstV36(uint8_t reg,uint8_t* buf,uint8_t n){
  lcdSPI.beginTransaction(SPISettings(4000000,MSBFIRST,SPI_MODE0));
  digitalWrite(ICM_CS_PIN,LOW);lcdSPI.transfer(reg|0x80);for(uint8_t i=0;i<n;i++)buf[i]=lcdSPI.transfer(0x00);digitalWrite(ICM_CS_PIN,HIGH);
  lcdSPI.endTransaction();
  return true;
}
// ---- V36.2 akses register LSM6DS3: SPI (protokol sama dengan ICM: bit7=read) atau I2C ----
static bool imuLsmSpiV36=false;
static void lsmWriteRegV36(uint8_t reg,uint8_t val){if(imuLsmSpiV36)icmWriteRegV36(reg,val);else i2cWriteV31(imuAddressV31,reg,val);}
static uint8_t lsmReadRegV36(uint8_t reg){if(imuLsmSpiV36)return icmReadRegV36(reg);uint8_t v=0;i2cReadV31(imuAddressV31,reg,&v,1);return v;}
static bool lsmReadBurstV36(uint8_t reg,uint8_t* b,uint8_t n){if(imuLsmSpiV36)return icmReadBurstV36(reg,b,n);return i2cReadV31(imuAddressV31,reg,b,n);}

static bool initImuV31(){
  // Chip aktual di PCB produksi = ICM-42688-P (InvenSense/TDK) lewat SPI. Dicek duluan.
  uint8_t who=icmReadRegV36(0x75);   // WHO_AM_I, harus 0x47
  if(who==0x47){
    imuWhoV31=who;imuTypeV36=IMU_TYPE_ICM42688_V36;
    // FIX V36.2: dulu ditulis 0x10 = bit4 SPI_MODE (pindah ke SPI mode 1/2!), BUKAN reset.
    // Soft reset ICM-42688-P = bit0 (SOFT_RESET_CONFIG) -> 0x01. SPI tetap mode 0/3.
    icmWriteRegV36(0x11,0x01);delay(2);                 // DEVICE_CONFIG: soft reset
    delay(50);                                          // tunggu reset selesai
    icmWriteRegV36(0x4E,0x0F);                          // PWR_MGMT0: accel+gyro Low Noise mode
    delay(50);                                          // startup time accel/gyro LN mode (datasheet)
    icmWriteRegV36(0x4F,0x46);                          // GYRO_CONFIG0 : +-500 dps, ODR 1kHz
    icmWriteRegV36(0x50,0x46);                          // ACCEL_CONFIG0: +-4 g,   ODR 1kHz (headroom hentakan/polisi tidur)
    imuConnectedV31=true;return true;
  }
  // V36.2: alternatif LSM6DS3 / LSM6DS3TR-C / LSM6DSO. Dulu tipe ini tidak pernah terdeteksi
  // (kode bacanya ada tapi mati). Dicek lewat SPI (CS GPIO5 yang sama) dulu, lalu I2C 0x6A/0x6B.
  // WHO_AM_I reg 0x0F: 0x69 = LSM6DS3, 0x6A = LSM6DS3TR-C/LSM6DSL, 0x6C = LSM6DSO.
  {
    auto lsmWhoOk=[](uint8_t w){return w==0x69||w==0x6A||w==0x6C;};
    uint8_t w=icmReadRegV36(0x0F);
    bool found=false;
    if(lsmWhoOk(w)){imuLsmSpiV36=true;found=true;}
    else{
      const uint8_t la[2]={0x6A,0x6B};
      for(uint8_t i=0;i<2&&!found;i++){if(i2cReadV31(la[i],0x0F,&w,1)&&lsmWhoOk(w)){imuAddressV31=la[i];imuLsmSpiV36=false;found=true;}}
    }
    if(found){
      imuWhoV31=w;imuTypeV36=IMU_TYPE_LSM6DS3_V36;
      lsmWriteRegV36(0x12,0x01);delay(20);   // CTRL3_C: SW_RESET
      lsmWriteRegV36(0x12,0x44);             // CTRL3_C: BDU=1, IF_INC=1 (auto-increment burst)
      lsmWriteRegV36(0x10,0x68);             // CTRL1_XL: ODR 416 Hz, +-4 g
      lsmWriteRegV36(0x11,0x64);             // CTRL2_G : ODR 416 Hz, +-500 dps (sama dengan ICM)
      delay(30);
      imuConnectedV31=true;return true;
    }
  }
  // fallback: board breadboard lama dengan MPU6050 (I2C, tetap didukung untuk kompatibilitas)
  const uint8_t addrsV31[2] = {0x68, 0x69};
  for(uint8_t ai=0; ai<2; ++ai){
    const uint8_t a=addrsV31[ai]; uint8_t whoM=0;
    if(i2cReadV31(a,0x75,&whoM,1)&&(whoM==0x68||whoM==0x69||whoM==0x70||whoM==0x71||whoM==0x72||whoM==0x73)){
      imuAddressV31=a;imuWhoV31=whoM;imuTypeV36=IMU_TYPE_MPU6050_V36;i2cWriteV31(a,0x6B,0x00);delay(20);i2cWriteV31(a,0x1A,0x03);i2cWriteV31(a,0x1B,0x00);i2cWriteV31(a,0x1C,0x00);i2cWriteV31(a,0x19,0x04);imuConnectedV31=true;return true;
    }
  }
  imuTypeV36=IMU_TYPE_NONE_V36;imuConnectedV31=false;return false;
}
static void saveImuOffsetsV31(){prefsV31.putFloat("oax",imuOffAxV31);prefsV31.putFloat("oay",imuOffAyV31);prefsV31.putFloat("oaz",imuOffAzV31);prefsV31.putFloat("ogx",imuOffGxV31);prefsV31.putFloat("ogy",imuOffGyV31);prefsV31.putFloat("ogz",imuOffGzV31);}
static void startImuCalV31(uint8_t mode){imuCalModeV31=mode;imuCalActiveV31=true;imuCalCountV31=0;calAxV31=calAyV31=calAzV31=calGxV31=calGyV31=calGzV31=0;screenDirtyV31=true;}
static void serviceImuV31(){
  uint32_t nowUs=micros(); if(!imuConnectedV31){if(millis()-imuLastRetryV31>2000){imuLastRetryV31=millis();initImuV31();}return;} if((uint32_t)(nowUs-imuLastUsV31)<5000UL)return;imuLastUsV31=nowUs;
  float ax,ay,az,gx,gy,gz;
  if(imuTypeV36==IMU_TYPE_ICM42688_V36){
    // V36.2: burst read SPI tidak pernah "gagal" (jalur kosong terbaca 0x00/0xFF), jadi dulu IMU
    // yang lepas tetap dianggap tersambung dengan data ngawur. Cek WHO_AM_I tiap 1 detik.
    if(millis()-imuWhoCheckMsV36>1000UL){imuWhoCheckMsV36=millis();if(icmReadRegV36(0x75)!=0x47){imuConnectedV31=false;imuTypeV36=IMU_TYPE_NONE_V36;Serial.println("IMU LOST (WHO_AM_I)");return;}}
    // ICM-42688-P: 0x1F = ACCEL_DATA_X1, lalu Y,Z, lalu GYRO X,Y,Z -- big-endian (MSB dulu), sama seperti MPU6050
    uint8_t b[12];if(!icmReadBurstV36(0x1F,b,12)){if(++imuErrorsV31>20){imuConnectedV31=false;imuErrorsV31=0;}return;}imuErrorsV31=0;
    auto s16=[&](uint8_t o)->int16_t{return (int16_t)(((uint16_t)b[o]<<8)|b[o+1]);};
