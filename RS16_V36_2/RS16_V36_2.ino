static void drawRs16LogoV32(int16_t x, int16_t y) {
  if (fbActiveV36) {   // V36.2: versi framebuffer
    uint32_t p = 0;
    for (uint32_t i = 0; i < RS16_LOGO_V32_RLE_COUNT; i++) {
      uint16_t n = pgm_read_word(&RS16_LOGO_V32_RLE[i].count);
      const uint16_t color = pgm_read_word(&RS16_LOGO_V32_RLE[i].color);
      while (n--) { fillRect(x + (int16_t)(p % RS16_LOGO_V32_W), y + (int16_t)(p / RS16_LOGO_V32_W), 1, 1, color); p++; }
    }
    return;
  }
  lcdStartWrite();
  lcdSetWindowTx(x, y, x + RS16_LOGO_V32_W - 1, y + RS16_LOGO_V32_H - 1);
  for (uint32_t i = 0; i < RS16_LOGO_V32_RLE_COUNT; i++) {
    uint16_t pixelCount = pgm_read_word(&RS16_LOGO_V32_RLE[i].count);
    uint16_t color      = pgm_read_word(&RS16_LOGO_V32_RLE[i].color);
    uint8_t hi = color >> 8;
    uint8_t lo = color & 0xFF;
    while (pixelCount--) {
      lcdSPI.transfer(hi);
      lcdSPI.transfer(lo);
    }
  }
  lcdEndWrite();
}


