  const char* sign=d<0?"-":"+"; uint32_t a=(uint32_t)(d<0?-d:d);
  snprintf(out,n,"%s%lu.%03lu",sign,(unsigned long)(a/1000UL),(unsigned long)(a%1000UL));
}

