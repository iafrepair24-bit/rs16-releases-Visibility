// delta live vs BEST (fallback LAST). return false kalau belum ada pembanding.
static bool dragCompareDeltaV36(int32_t* outDeltaMs,const char** outLabel){
  uint8_t m=dragCmpSlotV36((uint8_t)selectedDragMode); if(m>=DRAG_CMP_SLOTS_V36)return false;
  const DragCompareV36* ref=nullptr; const char* lab="BEST";
  if(dragBestV36[m].total)ref=&dragBestV36[m];
  else if(dragLastV36[m].total){ref=&dragLastV36[m];lab="LAST";}
  if(!ref)return false;
  if(dragRtV31.finished){
    if(!ref->total)return false;
    *outDeltaMs=(int32_t)dragRtV31.totalMs-(int32_t)ref->total; *outLabel=lab; return true;
  }
  if(dragRtV31.reached==0)return false;
  uint8_t i=dragRtV31.reached-1;
  if(dragRtV31.checkpointMs[i]==0xFFFFFFFFUL||ref->cp[i]==0||ref->cp[i]==0xFFFFFFFFUL)return false;
  *outDeltaMs=(int32_t)dragRtV31.checkpointMs[i]-(int32_t)ref->cp[i]; *outLabel=lab; return true;
}
